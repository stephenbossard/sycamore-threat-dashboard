piration":null,"is_active":1,"role":null},{"id":4579558961,"indicator":"5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78","type":"FileHash-SHA256","created":"2026-11-13T09:50:07","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579558962,"indicator":"http:\/\/api.cloudvflare.com:443","type":"URL","created":"2026-11-13T09:50:07","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579558963,"indicator":"api.cloudvflare.com","type":"hostname","created":"2026-11-13T09:50:07","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579559366,"indicator":"45.149.154.135","type":"IPv4","created":"2026-11-13T10:07:11","content":"","title":"","description":"CC=FR ASN=AS61317 digital energy technologies ltd.","expiration":"2026-12-13T10:00:00","is_active":1,"role":null},{"id":4579559367,"indicator":"31.41.33.212","type":"IPv4","created":"2026-11-13T10:07:11","content":"","title":"","description":"CC=RU ASN=ASNone","expiration":"2026-12-13T10:00:00","is_active":1,"role":null}],"tags":["babuk-derived","hypervisor","cve-2021-22005","cve-2023-34048","backup destruction","trigona","meshagent","vcenter","cve-2024-40711","conti","blacknevas","cve-2021-21985","lockbit","avoslocker","redalert","ligolo-ng","cve-2021-21974","cve-2021-21972","hive","cve-2025-22225","virtualization","babuk","cve-2024-37085","esxi","cve-2025-22226","cve-2024-38812","cve-2025-22224","gwisinlocker","cve-2024-38813","cve-2025-23120","host profiles","ransomhub"],"targeted_countries":[],"malware_families":["Babuk - S0638","Babyk","Vasa Locker","LockBit","GwisinLocker","Conti - S0575","AvosLocker - S1053","RedAlert","Hive","RansomHub","Trigona","MeshAgent","Ligolo-ng"],"attack_ids":["T1489","T1021.004","T1552","T1572","T1078.001","T1087","T1482","T1070","T1083","T1059.004","T1562.001","T1078","T1486","T1078.002","T1485","T1543.002","T1018","T1105","T1490","T1529"],"references":["https:\/\/securelist.com\/esxi-ransomware\/121959\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6af61f931cd135114986ff2c","name":"Luna Moth Returns, Re-Targeting Law Firms Through Access Tokens","description":"The extortion group Luna Moth is re-targeting law firms that previously declined to pay ransom demands, employing a novel token-based exfiltration technique. Attackers impersonate IT support via video calls, convincing victims to extract Microsoft Graph access tokens from Microsoft 365 Copilot through browser developer tools. These stolen tokens bypass MFA and Conditional Access controls since validation occurs only at issuance, enabling bulk file downloads within approximately one hour. The group has simplified its attack chain from earlier campaigns that relied on multiple remote-management tools and manual exfiltration. This shift represents a broader trend toward identity-focused attacks that avoid malware and endpoint detection. Organizations should implement Continuous Access Evaluation with strict location enforcement to invalidate tokens used outside authorized networks.","author_name":"AlienVault","modified":"2026-11-13T09:55:13.291000","created":"2026-11-12T20:20:35.298000","revision":2,"tlp":"white","public":1,"adversary":"Luna Moth","indicators":[{"id":4579068222,"indicator":"justsendtext.xyz","type":"domain","created":"2026-11-12T20:20:36","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579559046,"indicator":"104.37.184.195","type":"IPv4","created":"2026-11-13T09:50:44","content":"","title":"","description":"CC=US ASN=AS19318 interserver  inc","expiration":"2026-12-13T09:00:00","is_active":1,"role":null}],"tags":["social engineering","token theft","silent ransom group","conditional access","law firms","extortion","luna moth","microsoft graph"],"targeted_countries":[],"malware_families":[],"attack_ids":["T1213.002","T1204.002","T1566.002","T1598.003","T1071","T1190","T1567","T1550","T1185","T1528","T1204","T1534","T1048","T1566","T1567.002","T1132","T1598","T1213","T1071.001","T1550.001"],"references":["https:\/\/reliaquest.com\/blog\/threat-spotlight-luna-moth-returns-re-targeting-law-firms-through-access-tokens\/"],"industries":["Finance"],"extract_source":[],"more_indicators":false},{"id":"6af65cd84505f8125e2ca3ed","name":"Fake Zillow pages use ClickFix NetSupport RAT to target apartment hunters","description":"A ClickFix campaign deployed NetSupport RAT through fraudulent Zillow apartment-review pages targeting Windows users. The attack leveraged social engineering by presenting fake verification checks that copied PowerShell commands to victims' clipboards. Users were instructed to execute these commands via Win+R, Ctrl+V, Enter key combinations, which fetched malicious scripts from decimal-encoded IP addresses. The scripts deployed NetSupport Manager remote administration software configured to hide windows and persist through startup folders. Targets primarily included apartment hunters and renters, with particular risk to those using work laptops. The campaign utilized short-lived domains with random numeric suffixes on .sbs TLD and wildcard subdomains, suggesting personalized targeting through direct messaging rather than search poisoning or malvertising. Attribution remains uncertain as NetSupport RAT is widely used across multiple threat actors.","author_name":"AlienVault","modified":"2026-11-13T09:42:32.087000","created":"2026-11-13T00:42:00.055000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4471836655,"indicator":"89.34.90.203","type":"IPv4","created":"2026-11-13T00:42:00","content":"","title":"","description":"","expiration":"2026-12-13T00:00:00","is_active":1,"role":null},{"id":4579221408,"indicator":"apartments-review8509831.sbs","type":"domain","created":"2026-11-13T00:42:00","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579221409,"indicator":"asgomd.com","type":"domain","created":"2026-11-13T00:42:00","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579221410,"indicator":"asgrsv.com","type":"domain","created":"2026-11-13T00:42:00","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579221411,"indicator":"verify.apartments-review.sbs","type":"hostname","created":"2026-11-13T00:42:00","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["clickfix","powershell","netsupport rat","apartment scam","social engineering","remote access","rental fraud","fake zillow"],"targeted_countries":[],"malware_families":["NetSupport RAT"],"attack_ids":["T1059.001","T1140","T1132.001","T1102","T1566.002","T1105","T1547.001","T1564.003","T1071.001","T1027","T1036","T1219","T1204.001"],"references":["https:\/\/www.helpnetsecurity.com\/2026\/11\/13\/fake-zillow-clickfix-netsupport-rat\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6af6a2141941c1adfc3963ca","name":"2026-11-12: SmartApeSG ClickFix campaign pushes CNCmachineRMS RAT","description":"A malicious campaign utilizing SmartApeSG ClickFix (also known as BabaDeda) techniques has been observed distributing CNCmachineRMS RAT through fake CAPTCHA verification pages. The attack chain begins with compromised domains serving malicious JavaScript that injects ClickFix text for victims to paste into Windows Run windows. This retrieves an HTA file that subsequently downloads a ZIP archive containing a DLL side-loading package for deploying CNCmachineRMS RAT. The infection establishes command and control communication over TCP port 443 with encoded traffic. The campaign leverages social engineering through fraudulent CAPTCHA pages to trick users into executing malicious code, ultimately leading to RAT installation and persistent access.","author_name":"AlienVault","modified":"2026-11-13T09:35:21.256000","created":"2026-11-13T05:37:24.444000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4579236745,"indicator":"cashewminaret.org","type":"domain","created":"2026-11-13T05:37:25","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579236886,"indicator":"2eb387df728fc6f5dd2dcffaf1883cbf8c5e0c489f6cb38021d67f856ee669d0","type":"FileHash-SHA256","created":"2026-11-13T05:37:25","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579236888,"indicator":"101e9ac653ccd341e36fae84a5c6920dff47a41822e87db4c72e36da4830d707","type":"FileHash-SHA256","created":"2026-11-13T05:37:25","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4579496980,"indicator":"orchardandbarite.com","type":"domain","created":"2026-11-13T05:37:25","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["smartapesg","social engineering","cncmachinerms rat","clickfix","babadeda","hta","dll side-loading","fake captcha"],"targeted_countries":[],"malware_families":["CNCmachineRMS RAT"],"attack_ids":["T1566.002","T1140","T1036","T1218.005","T1547.001","T1566","T1204.003","T1027","T1573","T1203","T1059.003","T1027.002","T1071.001","T1105","T1204.001"],"references":["https:\/\/www.malware-traffic-analysis.net\/2026\/11\/12\/index.html"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6af6c5535313263a193f072b","name":"Beware of Phishing Email Disguised as Purchase Order Confirmation Request (Xloader)","description":"A phishing campaign distributes XLoader infostealer through emails disguised as purchase order confirmation requests. The attack chain begins with a malicious DOCX file that exploits Word's altChunk feature to execute an embedded RTF document. This RTF exploits CVE-2017-11882 through OLE objects to execute a VBS script, which drops encoded data and launches PowerShell scripts. The PowerShell scripts establish persistence through 