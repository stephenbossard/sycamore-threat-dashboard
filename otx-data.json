baa781368258f1bd51db42ca","type":"FileHash-SHA1","created":"2026-11-18T22:15:43","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590758325,"indicator":"e2955eb2718ac8b81695cea89718ebeea525dd59","type":"FileHash-SHA1","created":"2026-11-18T22:15:43","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["oidc-tokens","supply-chain-attack","pypi","agent-framework","github-actions","environment-variables","startup-hook","azure","credential-theft"],"targeted_countries":[],"malware_families":["agent-framework"],"attack_ids":["T1539","T1069","T1082","T1106","T1140","T1552.004","T1552.001","T1528","T1087.004","T1041","T1027","T1195.002","T1567.002","T1059.006","T1071.001","T1550.001","T1078.004","T1552.007"],"references":["https:\/\/www.elastic.co\/security-labs\/threat-command\/we-caught-the-agent-framework-pypi-compromise-six-minutes-after-it-published","https:\/\/static-www.elastic.co\/v3\/assets\/bltefdd0b53724fa2ce\/blt9f0c85b0fbfc8440\/6afdfa0277abc4ce81d3ae97\/image2.png"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6afe618212d4bcf4450d3cb6","name":"ROMULUS Campaign: CNCMachineRMS RAT Analysis","description":"Starting in late September 2026, widespread ClickFix activity was observed involving multiple malware delivery chains impersonating legitimate software. The ROMULUS platform distributed both CNCMachineRMS and LegionLoader through separate infection chains, utilizing ChatGPT Custom GPTs and DLL sideloading techniques. The investigation recovered a final RAT from a malicious Stardock installer employing encrypted payloads and a proprietary storage format. Analysis revealed strong similarities to CNCMachineRMS, previously documented in a separate BabaDeda infection chain, including family-specific identifiers and a custom scripting engine. The RAT supports persistent remote access, surveillance, system reconnaissance, and additional payload execution. ROMUL