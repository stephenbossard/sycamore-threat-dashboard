 targeting iOS 26 via CVE-2026-31001 was discovered but remains undeployed.","author_name":"AlienVault","modified":"2026-11-06T21:00:25.880000","created":"2026-10-07T21:37:32.724000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4077719937,"indicator":"CVE-2025-31200","type":"CVE","created":"2026-10-07T21:37:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4206322937,"indicator":"CVE-2025-24201","type":"CVE","created":"2026-10-07T21:37:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4282278715,"indicator":"escofiringbijou.com","type":"domain","created":"2026-10-07T21:37:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516060756,"indicator":"CVE-2026-31001","type":"CVE","created":"2026-10-07T21:37:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516060757,"indicator":"1334417664270db20af705f422878c53c8378203","type":"FileHash-SHA1","created":"2026-10-07T21:37:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516060758,"indicator":"864d68e64618d6bfc26d75d6f780ae0b7bfed3698cc8333818ed32519e560d1f","type":"FileHash-SHA256","created":"2026-10-07T21:37:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516060772,"indicator":"https:\/\/66ds.lol","type":"URL","created":"2026-10-07T21:37:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516060773,"indicator":"hdios.cn","type":"domain","created":"2026-10-07T21:37:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516060775,"indicator":"northlab.cn","type":"domain","created":"2026-10-07T21:37:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516060776,"indicator":"fc.rsqqq.top","type"