:1,"role":null},{"id":4516397687,"indicator":"gotenberg.dev","type":"domain","created":"2026-10-08T11:06:51","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["cryptocurrency mining","ai infrastructure targeting","poellm","botnet","gotenberg","ollama","xmrig","cve-2026-10520","litellm exploitation"],"targeted_countries":["United States of America"],"malware_families":["PoeLLM","XMRig","Iron"],"attack_ids":["T1053","T1140","T1190","T1219","T1583.001","T1595.002","T1090","T1583.003","T1110","T1059.004","T1027","T1573","T1203","T1496","T1071.001","T1584.004","T1018","T1046","T1105","T1102.001"],"references":["https:\/\/www.lumen.com\/blog\/en-us\/canto-incognito-tracking-the-poellm-malware"],"industries":["Technology"],"extract_source":[],"more_indicators":false},{"id":"6ac741ed2968234538d416fa","name":"RMM Tools Being Distributed Through Phishing Attacks (ScreenConnect, FleetDeck, Datto, SimpleHelp, JumpCloud, N-able)","description":"Multiple Remote Monitoring and Management (RMM) tools are being distributed through phishing campaigns involving video files and email attachments. Threat actors exploit legitimate RMM solutions like ScreenConnect, FleetDeck, Datto, SimpleHelp, JumpCloud, and N-able to gain remote access to compromised systems while evading security detection. These tools, typically used for legitimate IT administration purposes, are weaponized through various delivery methods including LNK files, BAT scripts, VBS files, and PDF documents disguised as business documents. The campaigns leverage social engineering tactics, presenting fake Adobe Acrobat updates, DocuSign viewers, and document access prompts to trick victims into installing these remote access tools. Each RMM tool contains configuration data linking back to attacker infrastructure, including deployment IDs, account identifiers, and command-and-control server addresses embedded within installation files.","author_name":"AlienVault","modified":"2026-11-07T07:02:31.206000","created":"2026-10-08T07:10:37.804000","revision":2,"tlp":"white","public":1,"adversary":"Scattered Spider","indicators":[{"id":4483159111,"indicator":"alertxen.store","type":"domain","created":"2026-10-08T07:10:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4503151718,"indicator":"bigsundoc.online","type":"domain","created":"2026-10-08T07:10:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516300927,"indicator":"1017a75cf19be75f6ba21148a9b646d1","type":"FileHash-MD5","created":"2026-10-08T07:10:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516300928,"indicator":"1562d523c2ebdc19c0ff8f3ea5f3763b","type":"FileHash-MD5","created":"2026-10-08T07:10:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516300929,"indicator":"594a652263e5e4eb96b5164d337bc1ca","type":"FileHash-MD5","created":"2026-10-08T07:10:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516300930,"indicator":"5a49d0b22ced22f9cf8b2015a327f163","type":"FileHash-MD5","created":"2026-10-08T07:10:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516300931,"indicator":"5ac7526b582d9cf4f7854c52ee75f359","type":"FileHash-MD5","created":"2026-10-08T07:10:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516300937,"indicator":"ddncsoso.com","type":"domain","created":"2026-10-08T07:10:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516300938,"indicator":"hessattorneys.co.za","type":"domain","created":"2026-10-08T07:10:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4516300939,"indicator":"relay.lukiku.lol","type":"hostname","created":"2026-10-08T07:10:38","content":""