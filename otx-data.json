ies":["NodeRemote","NetSupport Manager","MeshCentral","CastleRAT","NightshadeC2"],"attack_ids":["T1053.005","T1218.011","T1132.001","T1548.002","T1204.002","T1566.002","T1140","T1055","T1112","T1003.001","T1059.001","T1547.001","T1562.001","T1027","T1573","T1071.001","T1059.005","T1021.001","T1564.001","T1102.001"],"references":["https:\/\/any.run\/cybersecurity-blog\/us-logistics-cyber-threats-3-campaigns\/?utm_source=csn&amp;utm_medium=article&amp;utm_campaign=us_logistics&amp;utm_content=blog&amp;utm_term=181126"],"industries":["Transportation"],"extract_source":[],"more_indicators":false},{"id":"6afe238e2c4ba09cd1ded286","name":"agent-framework 1.26.1 and 1.26.2: PyPI credential stealer","description":"Microsoft's Agent Framework meta-package on PyPI was compromised with versions 1.26.1 and 1.26.2, published on November 17, 2026. Both versions deployed a .pth startup hook that executed credential-stealing code every time Python launched, requiring no package import. The stealer harvested Azure, Azure DevOps, and GitHub Actions tokens from environment variables across 300 running processes, credential files, and cloud metadata services. It collected tokens from Azure CLI caches, pip, npm, Docker, git, and Hugging Face credentials, then minted fresh cloud tokens via Azure DevOps and GitHub Actions OIDC endpoints and Azure Instance Metadata Service. All stolen data was compressed, Base64-encoded, and exfiltrated to a webhook.site endpoint. The compromise was detected within six minutes and removed within hours, but any host running these versions should be considered fully compromised.","author_name":"AlienVault","modified":"2026-11-19T10:40:32.444000","created":"2026-11-18T22:15:42.960000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4589503135,"indicator":"d27fa34414e6201d5e03e559ef634f020057554d7b3f4898dd5d7cd3e989e110","type":"FileHash-SHA256","created":"2026-11-18T22:15:43","content":"","title":"","description":"","expiration":null,