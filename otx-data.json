1e37b791e21c45feba54aec23d8","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299516,"indicator":"be19d98b5449a052c03b189d9687543d619c8c1893f12709ef6bef6ff7657510","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299517,"indicator":"c7e93e50f1f241e63e738925e4f8c7f8ee004506723c2b49ed0789100f4ce4ba","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299518,"indicator":"f85f44ebdd341f22f0cbd408ee40f162d697fc48c3824c897b61980fa38a4d92","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299519,"indicator":"helper.zulipchat.com","type":"hostname","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["pypi","dropper","wheel packages","supply chain attack","python packages","zichatbot","zulip c2","cross-platform"],"targeted_countries":[],"malware_families":["ZiChatBot"],"attack_ids":["T1132.001","T1195.001","T1036.005","T1204.002","T1574.001","T1106","T1140","T1055","T1547.001","T1059.004","T1027","T1102.002","T1059.006","T1070.004","T1027.002","T1071.001"],"references":["https:\/\/securelist.com\/oceanlotus-suspected-pypi-zichatbot-campaign\/119603\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69fb173ad966425db9cad018","name":"Data Extortion Groups Intensify Pressure On Global Aerospace Supply Chains","description":"Cyber threats targeting the global aviation and aerospace sector are rapidly evolving, with ransomware, identity-based intrusions, and platform-level disruptions becoming dominant attack vectors. The interconnected nature of this ecosystem, combined with time-sensitive operations and complex third-party dependencies, makes it highly attractive to threat actors. Shared airport IT platforms represent critical single points of failure, as demonstrated by the September 2025 ransomware attack on Collins Aerospace MUSE system that disrupted major European airports including Heathrow, Brussels, Berlin, and Dublin. Major ransomware groups like LockBit and Cl0p maintain heavy focus on aviation suppliers, while advanced persistent threat groups including Refined Kitten, Wicked Panda, and Fancy Bear conduct strategic espionage targeting intellectual property, aircraft design data, and military aviation intelligence. Emerging threats include vulnerabilities in regional airports, aviation SaaS platforms, and satellite ...","author_name":"AlienVault","modified":"2026-05-07T08:25:24.100000","created":"2026-05-06T10:26:02.393000","revision":2,"tlp":"white","public":1,"adversary":"LockBit, Cl0p, Refined Kitten, Wicked Panda, Fancy Bear","indicators":[{"id":4131119974,"indicator":"95daa771a28eaed76eb01e1e8f403f7c","type":"FileHash-MD5","created":"2026-05-06T10:26:03","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4131645418,"indicator":"cdd5717fd3bfd375c1c34237c24073e92ad6dccc","type":"FileHash-SHA1","created":"2026-05-06T10:26:03","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4131645544,"indicator":"7ea5afbc166c4e23498aa9747be81ceaf8dad90b8daa07a6e4644dc7c2277b82","type":"FileHash-SHA256","created":"2026-05-06T10:26:03","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4134888469,"indicator":"5e1f61b9c1c27cad3b7a81c804ac7b86","type":"FileHash-MD5","created":"2026-05-06T10:26:03","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4134888474,"indicator":"c1888ba296f57e87a84411ddfce3cabc4536b142","type":"FileHash-SHA1","created":"2026-05-06T10:26:03","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4134888475,"indicator":"180e93a091f8ab584a827da92c560c78f468c45f2539f73ab2deb308fb837b38","type":"FileHash-SHA256","created":"2026-05-06T10:26:03","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["critical infrastructure","aerospace","remus","data extortion","apt","espionage","supply chain attacks","aviation","lockbit","ransomware"],"targeted_countries":[],"malware_families":["LockBit","Remus"],"attack_ids":["T1583","T1133","T1082","T1071","T1562","T1195","T1190","T1567","T1589","T1021","T1070","T1041","T1199","T1566","T1078","T1027","T1486","T1598","T1588","T1213"],"references":["https:\/\/cyberpress.org\/aerospace-supply-chains-targeted\/"],"industries":["Aerospace","Transportation","Defense"],"extract_source":[],"more_indicators":false},{"id":"69fb17376737204f3abf5eaf","name":"Malware Bypasses Browser Application-Bound Encryption Protections","description":"A sophisticated 64-bit information-stealing malware named Remus has emerged as a direct evolution of the notorious Lumma Stealer. Following the doxxing of alleged Lumma core members between August and October 2025, developers created this advanced variant, with test builds appearing in September 2025 and live campaigns starting February 2026. Remus employs innovative techniques including injecting custom 51-byte shellcode into browser memory to extract protected master keys, bypassing Application-Bound Encryption in Chromium-based browsers. The malware utilizes EtherHiding through Ethereum smart contracts for command-and-control resolution, making infrastructure takedowns nearly impossible. It targets browser credentials, session cookies, and cryptocurrency wallets while implementing rigorous anti-analysis checks to evade security research environments.","author_name":"AlienVault","modified":"2026-05-07T08:24:23.730000","created":"2026-05-06T10:25:59.272000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4072393149,"indicator":"217.156.122.57","type":"IPv4","created":"2026-05-06T10:26:00","content":"","title":"","description":"","expiration":"2026-06-05T10:00:00","is_active":1,"role":null},{"id":4237266321,"indicator":"217.156.122.75","type":"IPv4","created":"2026-05-06T10:26:00","content":"","title":"","description":"","expiration":"2026-06-05T10:00:00","is_active":1,"role":null},{"id":4299571175,"indicator":"217.156.122.12","type":"IPv4","created":"2026-05-06T10:26:00","content":"","title":"","description":"","expiration":"2026-06-05T10:00:00","is_active":1,"role":null},{"id":4299571176,"indicator":"45.151.106.110","type":"IPv4","created":"2026-05-06T10:26:00","content":"","title":"","description":"","expiration":"2026-06-05T10:00:00","is_active":1,"role":null}],"tags":["etherhiding","browser credential theft","ethereum blockchain c2","remus","tenzor","cryptocurrency wallet theft","application-bound encryption bypass","information stealer","lumma stealer"],"targeted_countries":[],"malware_families":["Remus","Lumma Stealer","Tenzor"],"attack_ids":["T1003","T1539","T1082","T1106","T1140","T1036","T1055","T1555.003","T1059","T1497","T1552.001","T1562.001","T1027","T1573","T1518.001","T1070.004","T1134","T1071.001","T1105"],"references":["https:\/\/cyberpress.org\/remus-bypasses-browser-encryption\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69fb1736879a4a945346b9ba","name":"Multi-Stage AiTM Attack Uses Code Of Conduct Phishing Emails","description":"A sophisticated credential theft campaign targeting over 35,000 users across 13,000 organizations was observed between April 14-16, 2026. The operation primarily impacted the United States, particularly healthcare and financial services sectors. Attackers used code of conduct themed phishing emails masquerading as internal compliance communications, sent through legitimate email delivery services from attacker-controlled domains. Victims received polished HTML emails with PDF attachments containing fake disciplinary logs and CAPTCHA gates to evade automated analysis. The multi-stage attack chain ultimately directed users to counterfeit Microsoft authentication pages operating as adversary-in-the-middle infrastructure, enabling real-time interception of credentials and session tokens while bypassing multi-factor authentication defenses.","author_name":"AlienVault","modified":"2026-05-07T08:22:54.725000","created":"2026-05-06T10:25:58.883000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4343697607,"indicator":"acceptable-use-policy-calendly.de","type":"domain","created":"2026-05-06T10:25:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4343697608,"indicator":"cocinternal.com","type":"domain","created":"2026-05-06T10:25:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4343697609,"indicator":"compliance-protectionoutlook.de","type":"domain","created":"2026-05-06T10:25:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["aitm","financial services","credential theft","healthcare targeting","mfa bypass","captcha evasion","phishing campaign","session hijacking"],"targeted_countries":["United States of America"],"malware_families":[],"attack_ids":[],"references":["https:\/\/cyberpress.org\/aitm-attack-uses-phishing\/"],"industries":["Healthcare","Finance"],"extract_source":[],"more_indicators":false},{"id":"69d456693a5b7bc100e26cad","name":"Unit42: Understanding Current Threats to Kubernetes Environments","description":"Palo Alto Networks Unit 42 explains that Kubernetes has become a prime target for attackers as its adoption accelerates in enterprise environments. Their research shows a sharp rise in Kubernetes-related malicious activity, driven less by classic container escape techniques and more by identity abuse and exposed application surfaces. Threat actors commonly gain initial access through misconfigurations or newly disclosed vulnerabilities, then steal Kubernetes service account tokens mounted inside compromised containers. With these identities, attackers can escalate privileges, move laterally across clusters and cloud services, and reach highly sensitive backend systems, making Kubernetes an effective pivot point into broader cloud infrastructure.","author_name":"AlienVault","modified":"2026-05-07T00:00:42.275000","created":"2026-04-07T00:57:13.022000","revision":3,"tlp":"white","public":1,"adversary":"","indicators":[{"id":123444132,"indicator":"45.76.155.14","type":"IPv4","created":"2026-04-07T09:52:00","content":"","title":"","description":"CC=SG ASN=AS20473 the constant company  llc","expiration":"2026-05-07T09:00:00","is_active":1,"role":null},{"id":4157551390,"indicator":"CVE-2025-55182","type":"CVE","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4158471672,"indicator":"http:\/\/45.76.155.14\/vim","type":"URL","created":"2026-04-07T09:52:00","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4178459136,"indicator":"2c1d348131c4e3e1cb00002f226bad7e","type":"FileHash-MD5","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4178459142,"indicator":"9cdbc16912dcf188a0f0765ac21777b23b4b2bea","type":"FileHash-SHA1","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4178459143,"indicator":"05eac3663d47a29da0d32f67e10d161f831138e10958dcd88b9dc97038948f69","type":"FileHash-SHA256","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4200504512,"indicator":"CVE-2026-1731","type":"CVE","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4297738367,"indicator":"7d2c9b4a3942f6029d2de7f73723b505b64caa8e1763e4eb1f134360465185d0","type":"FileHash-SHA256","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4297738368,"indicator":"bb470a803b6d7b12fb596d2e4a18ea9ca91f40fd34ded7f01a487eed9a1d814d","type":"FileHash-SHA256","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4297957152,"indicator":"http:\/\/104.238.149.198:12349\/BVN0VEdddye5odDFVR","type":"URL","created":"2026-04-07T09:52:00","content":"","title":"","description":"","expiration":null,"is_active":1,"role":""}],"tags":["React2Shell","Kubernetes"],"targeted_countries":[],"malware_families":[],"attack_ids":["T1106","T1036","T1098","T1059","T1611","T1134","T1055","T1078","T1613"],"references":["https:\/\/unit42.paloaltonetworks.com\/modern-kubernetes-threats\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69d3cb85f3db16d53c999e18","name":"Seqrite: Advisory: Middle East Conflict & Cyber Escalation","description":"Iran\u2019s cyber ecosystem operates through a layered structure that combines state-directed APT groups (IRGC-linked and MOIS-linked); semi-official contractors and front entities; hacktivist personas and collectives operated by intelligence services; and ideologically aligned foreign collectives operating in parallel. The Stryker Corporation attack on March 11, 2026 marked a significant escalation: a destructive wiper operation against the US, executed without malware by abusing legitimate MDM infrastructure representing a qualitative shift in Iranian operational capability and willingness to target Western corporate infrastructure.","author_name":"AlienVault","modified":"2026-05-06T15:05:00.873000","created":"2026-04-06T15:04:37.387000","revision":2,"tlp":"white","public":1,"adversary":"Stryker","indicators":[{"id":2199241492,"indicator":"CVE-2017-7921","type":"CVE","created":"2026-04-06T15:04:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4225507196,"indicator":"CVE-2023-6895","type":"CVE","created":"2026-04-06T15:04:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4237426149,"indicator":"filebulldogs.com","type":"domain","created":"2026-04-06T15:04:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4245089653,"indicator":"e-kflower.com","type":"domain","created":"2026-04-06T15:04:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4277066510,"indicator":"tdtqy-oyaaa-aaaae-af2dq-cai.raw.icp0.io","type":"hostname","created":"2026-04-06T15:04:38","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["apt","muddywater","seedworm","government","iran","stryker"],"targeted_countries":[],"malware_families":[],"attack_ids":[],"references":["https:\/\/www.seqrite.com\/blog\/iran-us-israel-cyberwar-2026-analysis\/"],"industries":["Government"],"extract_source":[],"more_indicators":false},{"id":"69fa3e5f84a20294f972fa64","name":"Iranian-Nexus Operation Against Oman's Government: 12 Ministries Hit and 26,000 Citizen Records Exposed","description":"An exposed command and control server on RouterHosting infrastructure revealed an active Iranian-nexus intrusion campaign targeting twelve Omani government ministries. The operation primarily focused on the Ministry of Justice and Legal Affairs, deploying custom webshells that provided persistent access through April 2026. Over 26,000 user records containing judicial case data, committee decisions, and registry hives were exfiltrated. The attacker utilized ProxyShell exploits, DotNetNuke vulnerabilities, and custom Python scripts targeting Exchange servers, SQL databases, and Oracle systems. Infrastructure analysis revealed connections to spoofed Iranian diaspora media and censorship circumvention tools, with tactical overlaps indicating MOIS-linked groups such as APT34 and MuddyWater. The campaign specifically targeted judicial records, immigration systems, and citizen identity data across multiple government entities.","author_name":"AlienVault","modified":"2026-05-06T10:11:37.419000","created":"2026-05-05T19:00:47.456000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4345259490,"indicator":"ecc3611f7dcbaa53acf44e67de2f10d78a26e03b3c77ba28bbd3ee16b2e66437","type":"FileHash-SHA256","created":"2026-05-05T19:00:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4345259491,"indicator":"brnettlix.com","type":"domain","created":"2026-05-05T19:00:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4345259492,"indicator":"brttfrixx.com","type":"domain","created":"2026-05-05T19:00:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4345259493,"indicator":"identificara.com","type":"domain","created":"2026-05-05T19:00:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4345259494,"indicator":"mjla.gov.om","type":"domain","created":"2026-05-05T19:00:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4345259495,"indicator":"realprimefix.com","type":"domain","created":"2026-05-05T19:00:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4345259496,"indicator":"regorixa.com","type":"domain","created":"2026-05-05T19:00:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4345259497,"indicator":"sailms.gov.om","type":"domain","created":"2026-05-05T19:00:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4345259498,"indicator":"suanefllix.com","type":"domain",