734,"indicator":"adsparkpro.top","type":"domain","created":"2026-06-02T14:33:50","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4390164735,"indicator":"softwe.art","type":"domain","created":"2026-06-02T14:33:50","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["shell companies","calendaromatic","browser hijacking","jscorerunner","javascript bridge","fluttershell","recipelister","macos","flutterbridge","google ads","backdoor"],"targeted_countries":[],"malware_families":["FlutterShell","JSCoreRunner","RecipeLister","Calendaromatic"],"attack_ids":["T1539","T1553.002","T1082","T1176","T1106","T1005","T1036","T1185","T1555.003","T1083","T1204","T1041","T1547.001","T1566","T1059.004","T1027","T1573","T1543.001","T1189","T1071.001"],"references":["https:\/\/unit42.paloaltonetworks.com\/flutterbridge-new-fluttershell-backdoor\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6a1eeafdcfdd2d861d3662f3","name":"Iran Expands Handala Brand to Physical Threats","description":"Iran's Ministry of Intelligence has broadened its Handala brand beyond cyber operations to include physical threats and influence campaigns targeting US and Israeli interests. The expansion encompasses multiple personas: Handala Popular Resistance Front claiming physical attacks inside Israel, VIPEmployment recruiting proxies globally for espionage and sabotage, and MOISIRAN conducting surveillance operations. These entities engage in coordinated amplification across platforms, soliciting individuals to conduct attacks for financial rewards. The consolidation creates a multi-domain threat combining hacktivist activities with physical operations, espionage recruitment, and influence campaigns. This approach leverages Handala Hack Team's recognition to amplify recruitment efforts while increasing risks to law enforcement, military, intelligence personnel, and critical infrastructure across targeted regions.","author_name":"AlienVault","modified":"2026-06-03T09:27:35.542000","created":"2026-06-02T14:38:53.591000","revision":2,"tlp":"white","public":1,"adversary":"Void Manticore","indicators":[{"id":3942478690,"indicator":"justicehomeland.ru","type":"domain","created":"2026-06-02T14:38:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4332533815,"indicator":"handala.red","type":"domain","created":"2026-06-02T14:38:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4335556380,"indicator":"handala-hack.tw","type":"domain","created":"2026-06-02T14:38:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4335556381,"indicator":"justicehomeland.org","type":"domain","created":"2026-06-02T14:38:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4390240913,"indicator":"justicehomeland.info","type":"domain","created":"2026-06-02T14:38:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["hprf","void manticore","proxy recruitment","handala hack team","coordinated inauthentic behavior","cryptocurrency payments","telegram recruitment","physical operations","israeli targeting","bibi wiper","wiper attacks"],"targeted_countries":["United States of America","Albania","Israel"],"malware_families":["BiBi wiper"],"attack_ids":["T1583","T1071","T1195","T1190","T1589","T1586","T1204","T1591","T1059.001","T1590","T1048","T1566","T1565","T1078","T1027","T1486","T1598","T1585","T1485","T1574.002"],"references":["https:\/\/www.recordedfuture.com\/research\/iran-handala-physical-threats","https:\/\/www.recordedfuture.com\/research\/media_14c4348cdfe3e4e2b574896b502432695b25c37a9.gif?width=1200&format=pjpg&optimize=medium"],"industries":["Government","Defense","Energy","Transportation","Technology"],"extract_source":[],"more_indicators":false},{"id":"6a1f29d52e7ef5590675949f","name":"From Token Bingo to MAX Takeover: Kali365 Operator Expands Operation Across Microsoft Outlook, Okta, Xerox DocuShare, and Other Services","description":"A significant expansion of the Kali365 phishing-as-a-service operation has been observed, now targeting multiple platforms beyond Microsoft 365. The operator abuses OAuth 2.0 device authorization flows to bypass MFA and steal authentication tokens. Key discoveries include a live command-and-control panel infrastructure, a phishing campaign impersonating MAX Messenger (Russia's state-backed messaging platform with 110 million users) through fake prize-claim flows, and a cluster of 126 malicious hosts impersonating services including Microsoft Outlook, Okta SSO, Xerox DocuShare, Mail.ru, Yandex Disk, and Odnoklassniki. The operation demonstrates a deliberate focus on Russian consumer platforms alongside Western enterprise targets, utilizing Telegram bots for credential exfiltration and employing a multi-tenant phishing platform distributed through Telegram channels.","author_name":"AlienVault","modified":"2026-06-03T09:24:53.136000","created":"2026-06-02T19:07:01.258000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":3614052767,"indicator":"attachedfile.com","type":"domain","created":"2026-06-02T19:07:02","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4391146646,"indicator":"febb622cd9eeb5c8860dcef4cbfd4b74","type":"FileHash-MD5","created":"2026-06-02T19:07:02","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4391146647,"indicator":"6894a51278ec89118276c2dd2dc36e6f9ea2790a","type":"FileHash-SHA1","created":"2026-06-02T19:07:02","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4391146648,"indicator":"http:\/\/panel.securehubcloud.com\/login","type":"URL","created":"2026-06-02T19:07:02","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4391146649,"indicator":"greatness-marketing.top","type":"domain","created":"2026-06-02T19:07:02","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4391146650,"indicator":"securehubcloud.com","type":"domain","created":"2026-06-02T19:07:02","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4391146651,"indicator":"api.securehubcloud.com","type":"hostname","created":"2026-06-02T19:07:02","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4391146652,"indicator":"boss.securehubcloud.com","type":"hostname","created":"2026-06-02T19:07:02","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4391146653,"indicator":"panel.securehubcloud.com","type":"hostname","created":"2026-06-02T19:07:02","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["max messenger","ekz infostealer","device code phishing","oauth 2.0 abuse","phishing-as-a-service","russian platforms","kali365","mfa bypass","token theft"],"targeted_countries":[],"malware_families":["EKZ Infostealer"],"attack_ids":["T1539","T1566.002","T1566.001","T1071","T1140","T1550","T1090","T1102","T1528","T1204","T1098","T1566","T1078","T1027","T1102.002","T1071.001","T1204.001","T1550.001","T1078.004","T1566.003"],"references":["https:\/\/arcticwolf.com\/resources\/blog\/kali365-expands-into-aws-microsoft-okta-xerox-max-messenger\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6a1ac91f182b86c3c2bcfc15","name":"Nimbus RAT: How Threat Actors Are Abusing Microsoft Teams and Google Drive to Deploy a Java RAT","description":"In April 2026, threat actors deployed Nimbus RAT against a legal industry target using Microsoft Teams voice phishing. The attack began with email bombing (282 emails in 90 minutes), followed by a fake IT helpdesk contact via Teams who convinced the victim to grant Quick Assist remote access. Within 20 minutes, a Java-based RAT was deployed that uses Google Drive and Google Sheets for command-and-control, making network traffic appear benign. Analysis of 1,540 suspicious Teams messages across 172 customer environments over 12 months revealed 65% originated from throwaway onmicrosoft.com tenants with IT-themed names. The malware bundles its own Java runtime, implements two credential theft mechanisms, and allows in-memory second-stage code execution. Post-compromise targeting included Signal Desktop attachments and Outlook mailboxes.","author_name":"AlienVault","modified":"2026-06-02T09:35:48.744000","created":"2026-05-30T11:25:19.600000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4348910541,"indicator":"helpdock.top","type":"domain","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4348910542,"indicator":"scanseq.top","type":"domain","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4348910543,"indicator":"serviceprohub.top","type":"domain","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4348910544,"indicator":"system-clean.top","type":"domain","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385210256,"indicator":"44f6101dd8171133f53317bfd752300e","type":"FileHash-MD5","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385210257,"indicator":"fab69acd743f4111b749e3268690825c38822e62","type":"FileHash-SHA1","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385210258,"indicator":"91e523a46f3bb860ac2e5800b7e1ec89d75a2408410b9cd25eebc17c8d7a92bc","type":"FileHash-SHA256","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385210259,"indicator":"99813f3d0625e880158c68039c0e2fbf488db0be3db77cd1ce6d382644193f0e","type":"FileHash-SHA256","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385210260,"indicator":"9e5b1e10ad6904d3f5b48d38470cd57263974640a27d13cf793ef026d3d6b886","type":"FileHash-SHA256","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385210261,"indicator":"info-secure.top","type":"domain","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385210263,"indicator":"scan-security.top","type":"domain","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385210264,"indicator":"updt-scansecurity.top","type":"domain","created":"2026-05-30T11:25:20","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["vishing","quick assist","email bombing","microsoft teams","google drive c2","java rat","social engineering","nimbus rat"],"targeted_countries":[],"malware_families":["Nimbus RAT"],"attack_ids":["T1560.001","T1113","T1033","T1132.001","T1071.004","T1114.001","T1204.002","T1573.001","T1566.002","T1082","T1106","T1005","T1140","T1555","T1219","T1055","T1010","T1112","T1016","T1087","T1083","T1057","T1041","T1534","T1547.001","T1056.002","T1027","T1102.002","T1059.003","T1071.001"],"references":["https:\/\/www.esentire.com\/blog\/nimbus-rat-how-threat-actors-are-abusing-microsoft-teams-and-google-drive-to-deploy-a-java-rat"],"industries":["Legal"],"extract_source":[],"more_indicators":false},{"id":"6a1a7e87ef88fc3d7707a033","name":"Malicious npm packages abuse dependency confusion to profile developer environments","description":"Microsoft Threat Intelligence identified an active supply chain attack involving malicious npm packages that employ dependency confusion techniques. Between May 28-29, 2026, a threat actor using three maintainer aliases published malicious packages across nine organizational scopes that mirror real corporate namespaces. The packages execute obfuscated reconnaissance payloads through npm lifecycle hooks, collecting system information, environment variables, and developer credentials. All packages connect to the same command-and-control server and deploy a 17KB JavaScript dropper designed for environment fingerprinting. The campaign includes platform-specific payloads for Windows, macOS, and Linux, with CI\/CD detection bypass capabilities. The architecture operates in reconnaissance-only mode but supports server-side toggling for full exploitation. Forensic analysis indicates all three accounts are operated by a single individual, evidenced by shared C2 infrastructure, identical hardcoded authentication toke...","author_name":"AlienVault","modified":"2026-06-02T09:35:15.651000","created":"2026-05-30T06:07:03.273000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4383394475,"indicator":"oob.moika.tech","type":"hostname","created":"2026-05-30T06:07:04","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385126227,"indicator":"https:\/\/oob.moika.tech\/payload\/","type":"URL","created":"2026-05-30T06:07:04","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385127388,"indicator":"https:\/\/docs.cloudplatform-single-spa.io\/platform\/svp-baas","type":"URL","created":"2026-05-30T06:07:04","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4385127389,"indicator":"https:\/\/github.cloudplatform-single-spa.io\/platform\/svp-baas.git","type":"URL","created":"2026-05-30T06:07:04","content":"","title":"","description":