ng emails often contain buttons or links that redirect to fake login pages, closely resembling official Microsoft or Google login screens. The campaigns exploit the popularity of calendar invitations in corporate environments, allowing attackers to gather sensitive information if users are not vigilant. To prevent falling victim to these attacks, it is crucial to verify the authenticity of calendar invites, carefully check sender details, and avoid clicking suspicious links from unknown senders.","author_name":"AlienVault","modified":"2026-03-21T15:28:05.039000","created":"2026-02-19T15:26:25.602000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4216248716,"indicator":"http:\/\/135947.lachinadragon.com\/","type":"URL","created":"2026-02-19T15:26:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4216248717,"indicator":"http:\/\/6612271478.sbs\/google.php","type":"URL","created":"2026-02-19T15:26:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4216248718,"indicator":"http:\/\/a.insgly.net\/api\/trk?id=emailclick&i=660735&eid=156538024&url=hXXps:\/\/abramge.com.br\/drive\/itpresented","type":"URL","created":"2026-02-19T15:26:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4216248719,"indicator":"http:\/\/abramge.com.br\/drive\/itpresented\/\/","type":"URL","created":"2026-02-19T15:26:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4216248720,"indicator":"http:\/\/d60c1a.startprogrammingnowbook.com\/?auth=2&qrc=ZWxzLmZ&sso_reload=true","type":"URL","created":"2026-02-19T15:26:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4216248721,"indicator":"http:\/\/itsleannepelosi.com\/?sjzkrkrp","type":"URL","created":"2026-02-19T15:26:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":