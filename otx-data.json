fostealer","browser data theft","chromelevator","maas","c++"],"targeted_countries":[],"malware_families":["Arkanix Stealer","ChromElevator"],"attack_ids":["T1113","T1132.001","T1056.001","T1573.001","T1497.001","T1005","T1555","T1036","T1083","T1497","T1552.001","T1041","T1059.001","T1562.001","T1027","T1059.006","T1071.001","T1204.001"],"references":["https:\/\/securelist.com\/arkanix-stealer\/119006\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69bd18a56a2163e596b86133","name":"VoidStealer: Debugging Chrome to Steal Its Secrets","description":"VoidStealer is an emerging infostealer that employs a novel debugger-based Application-Bound Encryption (ABE) bypass technique. This method leverages hardware breakpoints to extract the v20_master_key directly from browser memory, requiring neither privilege escalation nor code injection. The technique involves attaching to the browser process as a debugger, setting breakpoints at strategic locations, and extracting the key when it's briefly present in plaintext. This approach offers a lower detection footprint compared to alternative bypass methods. The blog post dissects the technique step-by-step, from locating the target address for breakpoint placement to extracting the key. It also provides detection strategies for defenders, focusing on monitoring debugger attachments and suspicious browser memory reads.","author_name":"AlienVault","modified":"2026-03-20T21:06:50.989000","created":"2026-03-20T09:51:33.321000","revision":2,"tlp":"white","public":1,"adversary":"VoidStealer","indicators":[{"id":4274485721,"indicator":"befd84a29522d4350ae2f674f2ffcd8b","type":"FileHash-MD5","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4274485722,"indicator":"86cb3e6750f76c5d2d7eaeb176f5a5b92a2fbf7b","type":"FileHash-SHA1","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4274485723,"indicator":"f783fde5cf7930e4b3054393efadd3675b505cbef8e9d7ae58aa35b435adeea4","type":"FileHash-SHA256","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["abe bypass","memory analysis","edge","debugger-based technique","chrome","voidstealer","infostealer","hardware breakpoints","v20_master_key extraction"],"targeted_countries":[],"malware_families":["VoidStealer"],"attack_ids":[],"references":["https:\/\/www.gendigital.com\/blog\/insights\/research\/voidstealer-abe-bypass"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69bd18a7cc27dfdfaf6f56a4","name":"Widespread GitHub Actions Tag Compromise Exposes CI\/CD Secrets","description":"A new supply chain attack targeting Trivy has compromised 75 out of 76 version tags in the aquasecurity\/trivy-action GitHub repository. The attacker force-pushed these tags to serve malicious payloads, effectively turning trusted version references into a distribution mechanism for an infostealer. The malicious code executes within GitHub Actions runners, targeting sensitive data in CI\/CD environments. It harvests secrets from runner process memory and the filesystem, encrypts the collected data, and exfiltrates it to an attacker-controlled endpoint or a fallback GitHub-based channel. The attack's scope is significant, potentially affecting over 10,000 workflow files on GitHub referencing this action.","author_name":"AlienVault","modified":"2026-03-20T21:05:12.398000","created":"2026-03-20T09:51:35.029000","revision":2,"tlp":"white","public":1,"adversary":"TeamPCP","indicators":[{"id":4274485736,"indicator":"57a97c7e7821a5776cebc9bb87c984fa69cba8f1","type":"FileHash-SHA1","created":"2026-03-20T09:51:36","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4274485737,"indicator":"18a24f83e807479438dcab7a1804c51a00dafc1d526698a66e0640d1e5dd671a","type":"FileHash-SHA256","created":"2026-03-20T09:51:36","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4274485738,"indicator":"https:\/\/scan.aquasecurtiy.org","type":"URL","created":"2026-03-20T09:51:36","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4274485739,"indicator":"scan.aquasecurtiy.org","type":"hostname","created":"2026-03-20T09:51:36","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["ci\/cd","teampcp cloud stealer","credential theft","trivy","infostealer","supply chain attack","typosquat","github actions","exfiltration"],"targeted_countries":[],"malware_families":["TeamPCP Cloud stealer"],"attack_ids":["T1552.005","T1195","T1555","T1567","T1552","T1505.003","T1552.004","T1552.003","T1552.001","T1552.006","T1041","T1059.004","T1574","T1078","T1195.002","T1567.002","T1505","T1574.002","T1078.004"],"references":["https:\/\/socket.dev\/blog\/trivy-under-attack-again-github-actions-compromise"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69bd18a61f631ff045510990","name":"CVE-2026-33017: How attackers compromised Langflow AI pipelines in 20 hours","description":"A critical vulnerability in Langflow, an open-source visual framework for AI agents and RAG pipelines, was disclosed on March 17, 2026. The vulnerability, CVE-2026-33017, allows unauthenticated remote code execution on exposed Langflow instances. Within 20 hours, exploitation attempts were observed in the wild. Attackers rapidly developed working exploits from the advisory description and began scanning for vulnerable instances. The Sysdig Threat Research Team deployed honeypots to monitor the attacks, observing automated scanning, custom exploit scripts, and data harvesting activities. The rapid exploitation highlights the accelerating trend of shorter time-to-exploit for vulnerabilities, posing significant challenges for defenders. The attackers targeted high-value data, API keys, and potential software supply chain compromise.","author_name":"AlienVault","modified":"2026-03-20T21:02:18.495000","created":"2026-03-20T09:51:34.102000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4057002727,"indicator":"CVE-2025-3248","type":"CVE","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4269581004,"indicator":"CVE-2026-33017","type":"CVE","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4023615927,"indicator":"83.98.164.238","type":"IPv4","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":"2026-04-19T09:00:00","is_active":1,"role":null},{"id":4274485724,"indicator":"d6tcpc6flblph01gdcb0ku9ixih393m54.oast.live","type":"hostname","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4274485725,"indicator":"d6tcpe7nsv6kk9rdrpggi37zmjfxw9imr.oast.me","type":"hostname","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4274485726,"indicator":"d6td5s9qte0bea7273e0wuou77jjx77uk.oast.pro","type":"hostname","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4274485727,"indicator":"d6tgbe1qte0a8rkffb3gqabqm8517exd3.oast.fun","type":"hostname","created":"2026-03-20T09:51:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["cve-2026-33017","exploitation","data exfiltration","langflow","vulnerability","ai","rce","honeypot"],"targeted_countries":[],"malware_families":[],"attack_ids":["T1005","T1190","T1567","T1059","T1083","T1074","T1571","T1213","T1046"],"references":["https:\/\/www.sysdig.com\/blog\/cve-2026-33017-how-attackers-compromised-langflow-ai-pipelines-in-20-hours"],"industries":[],"extra