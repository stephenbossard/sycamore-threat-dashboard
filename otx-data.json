active":1,"role":null},{"id":4543043651,"indicator":"be0329d0795dd62ae587faf97e704bb36413e5c98ddd8fe575f5077db3c84e5f","type":"FileHash-SHA256","created":"2026-10-22T19:13:22","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4543043652,"indicator":"c1146fbcaa433385839c25839a61cd7fedaff858cc0d3fd063dba68db2cf31b4","type":"FileHash-SHA256","created":"2026-10-22T19:13:22","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4543043653,"indicator":"f3846ec2a6ff0a27d9ef2b9bf7908743b81d295ef29344acfb96ff83fff994f9","type":"FileHash-SHA256","created":"2026-10-22T19:13:22","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4543043654,"indicator":"fb1181160e9f10ce1eb5e5dc9bc23e1498a39110ee9ea361fd150454cb01b292","type":"FileHash-SHA256","created":"2026-10-22T19:13:22","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4543043655,"indicator":"209.99.186.187","type":"IPv4","created":"2026-10-22T19:13:22","content":"","title":"","description":"","expiration":"2026-11-21T19:00:00","is_active":1,"role":null},{"id":4543043656,"indicator":"choclatey.org","type":"domain","created":"2026-10-22T19:13:22","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4543043657,"indicator":"datamons.org","type":"domain","created":"2026-10-22T19:13:22","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4543043658,"indicator":"pymons.is","type":"domain","created":"2026-10-22T19:13:22","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4543043659,"indicator":"community.choclatey.org","type":"hostname","created":"2026-10-22T19:13:22","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["python malware","clipboard hijacking","armorsteal","seo poisoning","typosquatting","pyarmor"],"targeted_countries":[],"malware_families":["Armorsteal"],"attack_ids":["T1566","T1115","T1552.001","T1053.005","T1573","T1071.001","T1140","T1056.001","T1036.005","T1082","T1567.002","T1005","T1059.001","T1539","T1105","T1204","T1113","T1555.003","T1547.001","T1497.003"],"references":["https:\/\/www.zscaler.com\/blogs\/security-research\/seo-poisoning-campaign-delivers-new-armorsteal-malware"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6ada5f1e1071ed1bf4072f30","name":"StealC Is Back, and This Time It's a RAT","description":"Four months after Operation Endgame dismantled StealC in June, its seller returned in October with Stadia, a full-featured remote access trojan that incorporates StealC's code verbatim. Unlike its predecessor, Stadia offers comprehensive remote administration capabilities including hidden desktop control, live command shell, file explorer, process manager, and in-memory loader, with the original StealC stealer functioning as one of six modules. The operator targets former StealC customers by offering a free month on the top-tier subscription priced at $900 monthly. Analysis reveals the binary shares byte-for-byte code with StealC version 3.5, particularly the Chromium App-Bound Encryption helper. The agent communicates via plain HTTP to three hardcoded IP addresses, uses RC4 encryption with Base64 encoding, and establishes persistence through hidden scheduled tasks under C:\\ProgramData\\ with randomized directory names impersonating legitimate updaters. The transformation from simple infostealer to full RAT...","author_name":"AlienVault","modified":"2026-10-23T12:22:29.843000","created":"2026-10-22T19:08:14.184000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":3885984617,"indicator":"93.152.213.215","type":"IPv4","created":"2026-10-22T19:08:14","content":"","title":"","description":"","expiration":"2026-11-21T19:00:00","is_active":1,"role":null},{"id":4489595025,"indicator":"193.148.56.97","type":"IPv4","created":"2026-10-22T19:08:14","content":"","title":"","description":"","expiration":"2026-11-21T19:00:00","is_active":1,"role":null},{"id":4541519918,"indicator":"stadiadev.cc","type":"domain","created":"2026-10-22T19:08:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4542978707,"indicator":"028afae8b5e9953e1cd84a003c42fd85","type":"FileHash-MD5","created":"2026-10-22T19:08:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4542978708,"indicator":"7739a8d0d101ca82b93bbd0acdb6d9af","type":"FileHash-MD5","created":"2026-10-22T19:08:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4542978709,"indicator":"1ba76d2029744cc6e2f7209c96a696b32962b1f1","type":"FileHash-SHA1","created":"2026-10-22T19:08:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4542978710,"indicator":"0e5337a4cc8ebc772bc50f6e79befd1e8efad3410022e050d08d5269733c4ea4","type":"FileHash-SHA256","created":"2026-10-22T19:08:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4542978711,"indicator":"ea928494fd30d88b98141d39a502a4324889fb732e74b44bfee12c72137dd73e","type":"FileHash-SHA256","created":"2026-10-22T19:08:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4542978712,"indicator":"91.92.43.45","type":"IPv4","created":"2026-10-22T19:08:14","content":"","title":"","description":"","expiration":"2026-11-21T19:00:00","is_active":1,"role":null}],"tags":["operation endgame","stadia","hvnc","stealc"],"targeted_countries":[],"malware_families":["Stadia","StealC"],"attack_ids":["T1053.005","T1113","T1033","T1056.001","T1539","T1036.005","T1573.001","T1082","T1005","T1055","T1555.003","T1036.004","T1041","T1059.001","T1562.001","T1571","T1055.012","T1027","T1071.001","T1105"],"references":["https:\/\/www.varonis.com\/blog\/stealc-returns"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6ada5f20aaf6e87709a6dee5","name":"Beyond the Sandbox: Leveraging Android Intrusion Logs to Expose Advanced Threats","description":"Advanced Android threats increasingly operate beyond the standard application sandbox, requiring multi-layered detection strategies that combine on-device behavioral analysis with OS-level telemetry. Android's Delegated Scope enables enterprises to grant security applications access to security and network logs on managed devices without full MDM authority. The new Intrusion Logging feature extends similar forensic visibility to BYOD users through Advanced Protection on supported devices running Android 16 or later. This privacy-preserving capability allows users to collect and share encrypted security, DNS, and connection logs for analysis. The technical analysis demonstrates how these logs expose the complete RatHat attack chain, including Wireless Debugging self-pairing, ADB shell command execution, daemon staging, and command-and-control communications, providing actionable indicators of compromise across process execution, privileged operations, and network activity.","author_name":"AlienVault","modified":"2026-10-23T12:19:07.461000","created":"2026-10-22T19:08:16.738000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4512221840,"indicator":"bdfccc6ab3e592f6cfc47f6deb910950666fa47b5f87c6a08af7096d90e59d0f","type":"FileHash-SHA256","created":"2026-10-22T19:08:18","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4543042284,"indicator":"fegrs.adidasabc.com","type":"hostname","created":"2026-10-22T19:08:18","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["byod","intrusion logging","rathat"],"targeted_countries":[],"malware_families":["RatHat"],"attack_ids":["T1543","T1564","T1082","T1071","T1222","T1090","T1059","T1068","T1027","T1573","T1056","T1132"],"references":["https:\/\/zimperium.com\/blog\/beyond-the-sandbox-leveraging-android-intrusion-logs-to-expose-advanced-threats"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6ada5f2001908e1c7f2a85b3","name":"2026 Year End Phishing Lures","description":"As organizations approach year-end and fiscal close periods, employees face increased administrative activity in finance, HR, and IT departments. This heightened legitimate communication creates ideal cover for phishing campaigns. Attackers exploit year-end business processes by impersonating compensation adjustments, Q4 financial documents, access reviews, invoice follow-ups, and benefits statements. Multiple campaigns have been observed targeting organizations across sectors including aviation, telecommunications, manufacturing, real estate, technology, and financial services, with concentration in the Middle East. Attackers leverage SharePoint, Docusign, and Microsoft 365 themes, employing credential harvesting pages disguised as document-sharing portals. Generic protected-message lures prove effective by requiring minimal customization while appearing legitimate during busy periods when employees expect increased document requests and administrative deadlines.","author_name":"AlienVault","modified":"2026-10-23T12:18:00.371000","created":"2026-10-22T19:08:16.326000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":2196181226,"indicator":"157.7.189.101","type":"IPv4","created":"2026-10-23T11:46:39","content":"","title":"","description":"CC=JP ASN=AS7506 gmo internet","expiration":"2026-11-22T11:00:00","is_active":1,"role":null},{"id":3129637127,"indicator":"rsfashionsdesignbd.com","type":"domain","created":"2026-10-23T11:46:39","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":3612944166,"indicator":"157.7.44.119","type":"IPv4","created":"2026-10-23T11:46:39","content":"","title":"","description":"CC=JP ASN=AS7506 gmo