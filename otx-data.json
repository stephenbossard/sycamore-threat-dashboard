:"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4550040169,"indicator":"0405d4f79a3cc97fa492f1957cde0d51bc569f5432792f1b8f72077aa3fb2434","type":"FileHash-SHA256","created":"2026-10-28T14:25:18","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4539484200,"indicator":"CVE-2026-109619","type":"CVE","created":"2026-10-28T14:25:18","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4539484199,"indicator":"CVE-2026-109618","type":"CVE","created":"2026-10-28T14:25:18","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["impacket toolkit","database exfiltration","wrqsnx","privilege escalation","philippines government","open directory exposure","dcom exploitation","overseas employment","godpotato"],"targeted_countries":["Philippines"],"malware_families":["Wrqsnx","GodPotato"],"attack_ids":[],"references":["https:\/\/hunt.io\/blog\/philippine-government-employment-agency-records-stolen"],"industries":["Government"],"extract_source":[],"more_indicators":false},{"id":"6b087f709c81241d08ab4b97","name":"PolinRider Malware Force-Pushed Into AsyncAPI, CircuitVerse and Open Food Facts Pull Requests","description":"On October 19, 2026, the GitHub account Eternity0207 force-pushed malicious commits containing obfuscated PolinRider malware loaders into open pull requests across AsyncAPI Generator, CircuitVerse, and Open Food Facts. The loader was hidden in configuration files and fake font files, designed to steal credentials from developer machines and propagate itself. CircuitVerse's CI executed the payload, publishing 40 infected installers that remained available for over a month. The malware reads command-and-control server addresses from Ethereum wallet 0x1eef0849eda15d87f64e51c73c8442cf3c8bcef3, linked to the HuntRole fake recruiter campaign. Code searches revealed 576 infected repositories across 311 GitHub accounts. While none of the account's 145 merged pull requests contained the loader, the malicious code was force-pushed into open branches where it ran in CI environments without approval requirements.","author_name":"AlienVault","modified":"2026-11-27T07:49:28.767000","created":"2026-11-26T18:50:24.341000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4528850113,"indicator":"23.27.13.72","type":"IPv4","created":"2026-11-26T18:50:25","content":"","title":"","description":"","expiration":"2026-12-26T18:00:00","is_active":1,"role":null},{"id":4532241356,"indicator":"166.88.134.75","type":"IPv4","created":"2026-11-26T18:50:25","content":"","title":"","description":"","expiration":"2026-12-26T18:00:00","is_active":1,"role":null},{"id":4589336741,"indicator":"103.179.143.219","type":"IPv4","created":"2026-11-26T18:50:25","content":"","title":"","description":"","expiration":"2026-12-26T18:00:00","is_active":1,"role":null},{"id":4614434458,"indicator":"b02a81974810532fff8f76903e09b20431857bfaff00f2473421f4a4fb8162b5","type":"FileHash-SHA256","created":"2026-11-26T18:50:25","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4614434459,"indicator":"41a69ba3946396d2d1c15f2e43be705f0793e8773dee0f3dda89a541d31c00d9","type":"FileHash-SHA256","created":"2026-11-26T18:50:25","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4614434460,"indicator":"3ae470cabb9412bf5f0e64e1f71b458e14eb10b19070845597d5b8230b27d552","type":"FileHash-SHA256","created":"2026-11-26T18:50:25","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4614434466,"indicator":"edb26d5a44e40a9e3266ee8a83a0b2902fd93b6d","type":"FileHash-SHA1","created":"2026-11-26T18:50:25","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4614434463,"indicator":"c3d3f36443c98c6ee8473a87deeb1e4ce8a81bee","type":"FileHash-SHA1","created":"2026-11-26T18:5