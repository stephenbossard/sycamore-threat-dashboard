,"title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4365625375,"indicator":"8b6cfaa75fd4a1692d0c1e18d0aa32ebaa92094d","type":"FileHash-SHA1","created":"2026-05-21T15:39:25","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["PureLogs","PawsRunner","steganography","infostealer","phishing",".NET","credential theft","cryptocurrency wallets"],"targeted_countries":[],"malware_families":["PureLogs","PawsRunner"],"attack_ids":[],"references":["https:\/\/www.fortinet.com\/blog\/threat-research\/purelogs-delivery-via-pawsrunner-steganography"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6a0e37bba2c6b50f5bf38278","name":"Uncovering a Global Android Carrier Billing Fraud Campaign","description":"A sophisticated Android malware campaign has been identified conducting carrier billing fraud through premium SMS abuse across Malaysia, Thailand, Romania, and Croatia. The operation comprises nearly 250 malicious applications that selectively target users based on their mobile operators, silently subscribing victims to premium services without consent. The malware demonstrates advanced capabilities including precise regional targeting with hardcoded SIM operator validation, automated subscription workflows using WebView manipulation and JavaScript injection, OTP interception via abuse of Google's SMS Retriever API, and Telegram-based exfiltration of device metadata. The campaign impersonates popular applications including Facebook, Instagram, TikTok, Minecraft, and Grand Theft Auto to lure victims. Active from March 2025 through January 2026, the operation employs three distinct variants with increasing levels of sophistication, utilizing distributed command and control infrastructure and systematic refer...","author_name":"AlienVault","modified":"2026-05-21T16:51:58.805000","created":"2026-05-20T22:37:47.550000","revision":3,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4370230458,"indicator":"apkafa.com","type":"domain","created":"2026-05-20T22:37:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4370230459,"indicator":"modobomz.com","type":"domain","created":"2026-05-20T22:37:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4370230460,"indicator":"api.modobomco.com","type":"hostname","created":"2026-05-20T22:37:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4370230461,"indicator":"apizep.mwmze.com","type":"hostname","created":"2026-05-20T22:37:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4370230462,"indicator":"onesignal.mwmze.com","type":"hostname","created":"2026-05-20T22:37:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4370230463,"indicator":"onesignalmdb.modobomz.com","type":"hostname","created":"2026-05-20T22:37:48","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["android","telegram exfiltration","otp interception","webview manipulation","sms retriever api","premium sms","carrier billing fraud","southeast asia"],"targeted_countries":["Croatia","Malaysia","Romania","Thailand"],"malware_families":[],"attack_ids":[],"references":["https:\/\/zimperium.com\/blog\/premium-deception-uncovering-a-global-android-carrier-billing-fraud-campaign"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6a0c5b666ccb232590e33087","name":"The Worm That Keeps on Digging: Latest Wave","description":"A sophisticated supply chain campaign targeting the open source developer ecosystem has emerged, compromising NPM packages in the @antv namespace, GitHub Actions including actions-cool\/issues-helper, and the VSCode extension nrwl.angular-console. The malware initiates multi-stage infection chains using GitHub-hosted infrastructure and orphaned commits to deploy payloads via bun. It harvests extensive credentials including GitHub tokens, SSH keys, cloud credentials, and browser secrets, exfiltrating data through attacker-controlled public GitHub repositories. The campaign establishes persistence through a Python backdoor that polls GitHub for signed commands containing specific trigger strings, enabling remote code execution. Infrastructure analysis and operational patterns indicate moderate confidence attribution to the threat actor TeamPCP.","author_name":"AlienVault","modified":"2026-05-21T16:49:27.291000","created":"2026-05-19T12:45:26.087000","revision":2,"tlp":"white","public":1,"adversary":"TeamPCP","indicators":[{"id":4367347951,"indicator":"b06b126b9e26af03a7ef2f8b8e90d446","type":"FileHash-MD5","created":"2026-05-19T12:45:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4367347952,"indicator":"783b4019fc5b942a29846132d28441c8fc31bed8","type":"FileHash-SHA1","created":"2026-05-19T12:45:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4367347953,"indicator":"fb5c97557230a27460fdab01fafcfabeaa49590bafd5b6ef30501aa9e0a51142","type":"FileHash-SHA256","created":"2026-05-19T12:45:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4367347955,"indicator":"m-kosche.com","type":"domain","created":"2026-05-19T12:45:26","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["npm packages","supply chain attack","github actions","credential theft","cicd compromise","vscode extension","backdoor persistence","developer environments"],"targeted_countries":[],"malware_families":[],"attack_ids":["T1059.007","T1539","T1555.003","T1552.004","T1552.001","T1567.001","T1552.006","T1102.003","T1574.010","T1195.002","T1102.002","T1059.006","T1543.001","T1071.001","T1543.002","T1105","T1102.001"],"references":["https:\/\/www.wiz.io\/blog\/mini-shai-hulud-tea