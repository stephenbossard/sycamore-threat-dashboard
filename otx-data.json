ess, and an associated domain used for maintaining persistent access to compromised environments.","author_name":"AlienVault","modified":"2026-04-29T10:50:57.999000","created":"2026-04-29T10:49:26.327000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4143327692,"indicator":"gz.technicalprorj.xyz","type":"hostname","created":"2026-04-29T10:49:27","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4226518800,"indicator":"7ac9278876c83c9b597fae68acb6fbf9","type":"FileHash-MD5","created":"2026-04-29T10:49:27","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4226518802,"indicator":"18150c9b96bffd20c8203ff98a4fc153929bc2c9","type":"FileHash-SHA1","created":"2026-04-29T10:49:27","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4226518810,"indicator":"881619a47b62b52305d92640cc4d4845a279c23a5a749413785fc8fcb0fdf7fb","type":"FileHash-SHA256","created":"2026-04-29T10:49:27","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4333887976,"indicator":"fc27479ff929d846e7c5c5d147479c81e483a2ec911bd1501a53aa646a29620d","type":"FileHash-SHA256","created":"2026-04-29T10:49:27","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4333887977,"indicator":"d4fe9f48178cdf375a3be30d17f1dc016b5861dff8683f0bb35a0ba8d44f892f","type":"FileHash-SHA256","created":"2026-04-29T10:49:27","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4333887978,"indicator":"978ad86c90d85b74947bb627ec24f8bcd26812b500e82f5af202160506ac29c6","type":"FileHash-SHA256","created":"2026-04-29T10:49:27","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4333887979,"indicator":"968ecf51c442ec0ff91f91689ac524e7e8e9eab0c1a2a65cf13e54cf95194efe","type":"FileHash-SHA256","created":"2026-04-29T10:49:27","content":"",