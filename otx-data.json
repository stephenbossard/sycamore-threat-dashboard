chitecture is nearly fileless, leveraging NTFS Alternate Data Streams to conceal modules and using Dead Drop Resolvers on legitimate platforms like Telegram and Cloudflare for C2 infrastructure. Every stage functions as an independent backdoor capable of executing arbitrary VBScript, representing a shift from their historical Pteranodon framework to a modular ecosystem designed for persistent espionage.","author_name":"AlienVault","modified":"2026-06-02T09:24:58.011000","created":"2026-06-01T19:31:21.077000","revision":2,"tlp":"white","public":1,"adversary":"Gamaredon","indicators":[{"id":1678504708,"indicator":"CVE-2018-20250","type":"CVE","created":"2026-06-01T19:31:21","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4118610414,"indicator":"CVE-2025-8088","type":"CVE","created":"2026-06-01T19:31:21","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4160731132,"indicator":"iiwdsxwamylbwwsoyrmj.supabase.co","type":"hostname","created":"2026-06-01T19:31:21","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4172308707,"indicator":"quitethepastry.ru","type":"domain","created":"2026-06-01T19:31:21","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4389548584,"indicator":"1794369214b7f62e70a0485e61335c61","type":"FileHash-MD5","created":"2026-06-01T19:31:21","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4389548585,"indicator":"8e1624d110c090ff57d4b493a9107c66","type":"FileHash-MD5","created":"2026-06-01T19:31:21","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4389548586,"indicator":"104.194.140.6","type":"IPv4","created":"2026-06-01T19:31:21","content":"","title":"","description":"","expiration":"2026-07-01T19:00:00","is_active":1,"role":null},{"id":4389548587,"indicator":"https:\/\/efficiency-planes-emotions-fasci