ntent":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4335424686,"indicator":"a1da198bb4e883d077a0e13351bf2c3acdea10497152292e873d79d4f7420211","type":"FileHash-SHA256","created":"2026-04-30T00:12:45","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4335424687,"indicator":"eb6eb4154b03ec73218727dc643d26f4e14dfda2438112926bb5daf37ae8bcdb","type":"FileHash-SHA256","created":"2026-04-30T00:12:45","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["ci\/cd compromise","mini shai hulud","supply chain attack","github exfiltration","sap ecosystem","credential theft","npm packages"],"targeted_countries":[],"malware_families":["Mini Shai Hulud"],"attack_ids":["T1132.001","T1059.007","T1204.002","T1543.003","T1082","T1106","T1555","T1555.003","T1083","T1552.001","T1027","T1195.002","T1567.002","T1071.001","T1105","T1078.004","T1552.007"],"references":["https:\/\/www.wiz.io\/blog\/mini-shai-hulud-supply-chain-sap-npm"],"industries":["Technology"],"extract_source":[],"more_indicators":false},{"id":"69f29e7de2c7e622090df108","name":"Supply Chain Attack Hits SAP CAP and Cloud MTA npm Packages","description":"Multiple npm packages in the SAP JavaScript and cloud application development ecosystem were compromised in a suspected supply chain attack. Affected packages include mbt@1.2.48, @cap-js\/db-service@2.10.1, @cap-js\/postgres@2.2.2, and @cap-js\/sqlite@2.2.2. The compromised versions introduced malicious preinstall scripts that download and execute Bun binaries from GitHub, then run heavily obfuscated payloads designed to harvest credentials from developer machines and CI\/CD environments. The payloads steal SSH keys, cloud credentials, npm tokens, GitHub access, cryptocurrency wallets, and CI\/CD secrets directly from runner memory. Stolen data is encrypted and exfiltrated via GitHub repositories created under victim accounts. The malware also attempts self-propagation by injecting itself into additional packages using stolen npm tokens and establishes persistence through VSCode and Claude IDE configurations.","author_name":"AlienVault","modified":"2026-04-30T07:36:15.262000","created":"2026-04-30T00:12:45.577000","revision":2,"tlp":"white","public":1,"adversary":"TeamPCP","indicators":[{"id":4335424660,"indicator":"35baf8316645372eea40b91d48acb067","type":"FileHash-MD5","created":"2026-04-30T00:12:46","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4335424681,"indicator":"4066781fa830224c8bbcc3aa005a396657f9c8f9016f9a64ad44a9d7f5f45e34","type":"FileHash-SHA256","created":"2026-04-30T00:12:46","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4335424682,"indicator":"6f933d00b7d05678eb43c90963a80b8947c4ae6830182f89df31da9f568fea95","type":"FileHash-SHA256","created":"2026-04-30T00:12:46","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4335424683,"indicator":"80a3d2877813968ef847ae73b5eeeb70b9435254e74d7f07d8cf4057f0a710ac","type":"FileHash-SHA256","created":"2026-04-30T00:12:46","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4335424687,"indicator":"eb6eb4154b03ec73218727dc643d26f4e14dfda2438112926bb5daf37ae8bcdb","type":"FileHash-SHA256","created":"2026-04-30T00:12:46","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["credential-theft","supply-chain-attack","ci-cd-compromise","bun-binary","sap-cap","obfuscation","github-abuse","npm-packages"],"targeted_countries":[],"malware_families":[],"attack_ids":[],"references":["https:\/\/socket.dev\/blog\/sap-cap-npm-packages-supply-chain-attack"],"industries":["Technology"],"extract_source":[],"more_indicators":false},{"id":"69f29e7612b827a15dfc7787","name":"Komari Red: The Monitoring Tool with a Built-in Reverse Shell","description":"On April 16, 2026, a threat actor leveraged stolen VPN credentials to access a Windows workstation and deployed a SYSTEM-level backdoor using the Komari agent, an open-source monitoring tool with built-in command-and-control capabilities. The attacker authenticated through an SSLVPN session from IP 45.153.34[.]132 and used Impacket smbexec.py to enable RDP on the target system. The Komari agent was installed as a persistent Windows service named 'Windows Update Service' using NSSM, pulling the installer directly from the official GitHub repository. Komari provides bidirectional control through WebSocket connections, offering arbitrary command execution, interactive reverse shell access, and network probing capabilities by default. Microsoft Defender quarantined an earlier registry dump attempt, forcing the adversary to pivot to this GitHub-based approach. This represents the first publicly documented case of Komari being abused in a real-world intrusion.","author_name":"AlienVault","modified":"2026-04-30T07:34:23.124000","created":"2026-04-30T00:12:38.898000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4335424651,"indicator":"039e659ade3aa8ee7758c11fdb8fbfffd2491920046d638413cea2042f6d584c","type":"FileHash-SHA256","created":"2026-04-30T00:12:39","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4335424652,"indicator":"45.153.34.132","type":"IPv4","created":"2026-04-30T00:12:39","content":"","title":"","description":"","expiration":"2026-05-30T00:00:00","is_active":1,"role":null}],"tags":["rdp-enablement","credential-theft","sslvpn-compromise","impacket","nssm-persistence","reverse-shell","komari","github-infrastructure"],"targeted_countries":[],"malware_families":["Komari"],"attack_ids":["T1133","T1003.002","T1543.003","T1082","T1021.002","T1112","T1036.004","T1049","T1059.001","T1078","T1571","T1059.003","T1071.001","T1563.002","T1018","T1105","T1021.001","T1569.002","T1090.001"],"references":["https:\/\/www.huntress.com\/blog\/komari-c2-agent-abuse"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69cabb96c63dbeb412355267","name":"TeamPCP\u2019s Telnyx Attack Marks a Shift in Tactics Beyond LiteLLM","description":"TeamPCP launched a sophisticated attack on the Telnyx Python SDK, publishing malicious versions 4.87.1 and 4.87.2 to PyPI. The attack represents an evolution from their previous LiteLLM campaign, incorporating WAV-based steganography, split-file code injection, and expanded platform support. The payload, activated on import, uses stealthy techniques to download and execute credential-stealing malware across Linux, macOS, and Windows systems. Key changes include the use of audio steganography to hide malicious code, improved evasion through split-file injection, and the addition of Windows support with Startup folder persistence. The attackers shifted from HTTPS to plaintext HTTP infrastructure, potentially exposing their activities to network monitoring. Organizations are advised to downgrade to the last clean version and treat affected systems as compromised.","author_name":"AlienVault","modified":"2026-04-29T18:04:13.405000","created":"2026-03-30T18:06:14.535000","revision":3,"tlp":"white","public":1,"adversary":"TeamPCP","indicators":[{"id":4283528327,"indicator":"7321caa303fe96ded0492c747d2f353c4f7d17185656fe292ab0a59e2bd0b8d9","type":"FileHash-SHA256","created":"2026-03-30T18:06:15","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4283528328,"indicator":"cd08115806662469bbedec4b03f8427b97c8a4b3bc1442dc18b72b4e19395fe3","type":"FileHash-SHA256","created":"2026-03-30T18:06:15","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4287675478,"indicator":"5870a0bf82bbdf2687d8dce89dfa668f","type":"FileHash-MD5","created":"2026-03-30T18:06:15","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4287675479,"indicator":"4ce6ad55d8912a