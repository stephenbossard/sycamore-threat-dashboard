or flexible work during Amazon's legitimate holiday hiring season. Sites use identical icons and connected infrastructure, with domains like amzssapplication[.]com and applyamazonsp[.]com. Victims risk identity theft, involvement in fraud operations using stolen payment details, and financial losses through fake check schemes.","author_name":"AlienVault","modified":"2026-11-18T07:52:15.613000","created":"2026-11-17T15:14:15.837000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4587816212,"indicator":"amzssapplication.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816213,"indicator":"jobsamzss.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816214,"indicator":"applyamazonsp.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816215,"indicator":"amzncrew.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816216,"indicator":"joinamzn.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816217,"indicator":"workatamzn.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816218,"indicator":"amzshippings.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816219,"indicator":"applicationsamz.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816221,"indicator":"hiringamazonsp.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816222,"indicator":"hiringamzss.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816223,"indicator":"jobsamazonsp.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816224,"indicator":"joinamazonsp.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816225,"indicator":"onlineapplicationamz.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587816229,"indicator":"workatamazonsp.com","type":"domain","created":"2026-11-17T15:14:16","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["phishing","parcel mule","employment scam","amazon impersonation","identity theft","fake recruitment","social engineering","reshipping fraud"],"targeted_countries":[],"malware_families":[],"attack_ids":[],"references":["https:\/\/www.malwarebytes.com\/blog\/threat-intel\/2026\/11\/amazon-job-offer-promises-5000-a-month-but-its-got-all-the-signs-of-a-scam"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6afc6f463588da4e08ab1204","name":"AI Agents Targeted Through Malicious GitHub Repositories","description":"A sophisticated malware campaign has been discovered that targets developers using AI coding assistants through compromised GitHub repositories. The attack exploits configuration files and instruction documents that AI agents use to understand projects, such as AGENTS.md and CLAUDE.md. Twenty-two malicious repositories have been identified containing a concealed payload (setup.js) that steals credentials from platforms including GitHub, GitLab, AWS, Azure, and Google Cloud. The malware validates stolen tokens, modifies repositories, infects software packages, and propagates by injecting malicious instructions into AI-agent configuration files. It can also spread through victim accounts by committing malicious files to repositories with sufficient permissions, affecting npm, PyPI, RubyGems, and JFrog package ecosystems.","author_name":"AlienVault","modified":"2026-11-18T07:51:18.511000","created":"2026-11-17T15:14:14.316000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4587995580,"indicator":"b9a182b646c7fdff68f2ff9dfd822516","type":"FileHash-MD5","created":"2026-11-17T15:14:15","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587995581,"indicator":"2f54f6d41f41bb3c8e684b0f009cbcc3","type":"FileHash-MD5","created":"2026-11-17T15:14:15","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587995582,"indicator":"3794736979327349404171798328a38a","type":"FileHash-MD5","created":"2026-11-17T15:14:15","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587995583,"indicator":"ab7ff2f782c194953e5811d16b9e1817","type":"FileHash-MD5","created":"2026-11-17T15:14:15","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587995584,"indicator":"2191cbd04134839daeb6b8909725eae0","type":"FileHash-MD5","created":"2026-11-17T15:14:15","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587995585,"indicator":"31f1f5d9c59b950d91d05cecee20fce8","type":"FileHash-MD5","created":"2026-11-17T15:14:15","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4587995586,"indicator":"908293cd1ed04cf50fbe72baf74967b6","type":"FileHash-MD5","created":"2026-11-17T15:14:15","content":"","title":"","description":"","expiration"