odule logging keystrokes and swapping clipboard cryptocurrency addresses, and a comprehensive stealer targeting browser credentials, Discord tokens, cryptocurrency wallets, seed phrases, and password manager vaults. The kit employs 11 failover C2 domains and adds Windows Defender exclusions to avoid detection.","author_name":"AlienVault","modified":"2026-11-06T19:10:54.774000","created":"2026-11-06T14:11:04.969000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":3457594562,"indicator":"186.2.163.193","type":"IPv4","created":"2026-11-06T14:11:05","content":"","title":"","description":"","expiration":"2026-12-06T14:00:00","is_active":1,"role":null},{"id":4313343358,"indicator":"1d04536714bb22a3e909525a7dd627f0","type":"FileHash-MD5","created":"2026-11-06T14:11:05","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4313343452,"indicator":"affc166fa1874ff3ec0e42646e008cec972b76ab","type":"FileHash-SHA1","created":"2026-11-06T14:11:05","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4313343538,"indicator":"e857298fd2f8d1c7d48780769433f33e7b3ceaae5ea5a74c13ce8c10bcc7b690","type":"FileHash-SHA256","created":"2026-11-06T14:11:05","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4532192525,"indicator":"f61e7fc8b9e8243577bdc0a601fb22f3","type":"FileHash-MD5","created":"2026-11-06T14:11:05","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4532192526,"indicator":"bb40eaaf83450d6cd32abca2fa1cc3aea7beeb43","type":"FileHash-SHA1","created":"2026-11-06T14:11:05","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4532192527,"indicator":"253653f645b9c89e7e7e7e967926b0cf0f9adda98ac9d6ba4aa1eb354d80ab9d","type":"FileHash-SHA256","created":"2026-11-06T14:11:05","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":45