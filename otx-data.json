,"is_active":1,"role":null},{"id":4590585558,"indicator":"http:\/\/connectivity.androidstaticserve.com\/blue\/B67j96dg.php","type":"URL","created":"2026-11-18T13:32:41","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590585559,"indicator":"http:\/\/meta.androidasynclib.com\/azure\/H54F257gd4.php","type":"URL","created":"2026-11-18T13:32:41","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590585560,"indicator":"http:\/\/static.androidufslib.com\/hotel\/H28j75Ft.php","type":"URL","created":"2026-11-18T13:32:41","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590585561,"indicator":"an-east.androidannotations.com","type":"hostname","created":"2026-11-18T13:32:41","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590585562,"indicator":"api.androidwebsys.com","type":"hostname","created":"2026-11-18T13:32:41","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["gravityrat","pakistan-aligned","spacecobra","android surveillance","heavylift","fake recruitment portals","defense targeting","mobile espionage","cosmic leopard"],"targeted_countries":["British Indian Ocean Territory","India"],"malware_families":["GravityRAT - S0237","HeavyLift"],"attack_ids":[],"references":["https:\/\/www.lookout.com\/threat-intelligence\/article\/gravityrat-spyware"],"industries":["Defense","Aerospace"],"extract_source":[],"more_indicators":false},{"id":"6afdaa416a4121d2f40898b5","name":"Optimizely Supply Chain Attack Distributes Malware Across Global Brands","description":"An attacker exploited a vulnerability in Optimizely's Web Experimentation platform on November 16, 2026, compromising 188 JavaScript snippets across 178 organizations including BBC, CNN, Zoom, GitLab, IKEA, and HSBC. The exploit targeted the optional Project JavaScript field in Optimizely's A\/B testing service, allowing malicious code injection through trusted infrastructure. Visitors to affected websites were exposed to cryptocurrency wallet address clippers that replaced legitimate addresses with attacker-controlled ones, payment card skimmers, and iOS-specific exploit kits. The attack leveraged encoded JavaScript modules that intercepted clipboard operations, monitored page content through MutationObservers, and delivered platform-specific payloads. Optimizely patched the vulnerability, removed injected code, revoked tokens, and reset affected accounts by November 16 at 23:11 UTC.","author_name":"AlienVault","modified":"2026-11-19T10:46:03.279000","created":"2026-11-18T13:38:09.592000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4589503142,"indicator":"1ec4245b3b303304ea24a89b3b2351b0f0c085087050f517d23dcba9694c165a","type":"FileHash-SHA256","created":"2026-11-18T13:38:10","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["supply chain attack","optimizely","ios exploit kit","card skimmer","cryptocurrency clipper","javascript injection","third-party compromise"],"targeted_countries":[],"malware_families":[],"attack_ids":["T1112","T1027","T1071.001","T1140","T1056.002","T1114","T1539","T1056.001","T1573","T1059.007","T1195.002","T1555.003","T1185","T1005","T1213","T1039","T1560","T1528","T1204.001","T1036.005"],"references":["https:\/\/socket.dev\/blog\/optimizely-supply-chain-attack"],"industries":["Media","Technology","Finance","Retail","Government"],"extract_source":[],"more_indicators":false},{"id":"6afdaa4262eb5177f038db47","name":"Behind the Power Outage: Unmasking a New Intrusion Vector in Enterprise Infrastructure Tools","description":"Threat actors exploited CyberPower PowerPanel Business (PPB), a UPS management software, as an execution channel on a Windows domain controller. The attackers leveraged PPB's legitimate feature that runs scripts during power events by uploading malicious .cmd files through the web console on TCP port 3052. Commands executed through the PowerPanel service (ppbed.exe) ran with SYSTEM privileges. The intrusion involved iterative script development to dump Active Directory credentials using ntdsutil and esentutl, downloading tools via certutil, and deploying a persistent implant through DLL side-loading. This technique allowed attackers to hide within trusted infrastructure management software, making detection challenging as activities appeared to originate from legitimate power-management processes.","author_name":"AlienVault","modified":"2026-11-19T10:45:13.181000","created":"2026-11-18T13:38:10.022000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4590585531,"indicator":"04206431c83d1d81726e56fffb5166c0a7f138eb366e5aa918dee54af1ef22b5","type":"FileHash-SHA256","created":"2026-11-18T13:38:10","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590585532,"indicator":"12e716f48875befa978ff4a78a0b99a18b1809fc5bcc34c761158875da611aa8","type":"FileHash-SHA256","created":"2026-11-18T13:38:10","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590585533,"indicator":"1949894c26e03d6f15ed7f4393a89dbd52f8acc62959d3d5e4f695d6a19c6d9c","type":"FileHash-SHA256","created":"2026-11-18T13:38:10","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590585534,"indicator":"22b8f2776f1c941d8240ee4243da537147f8d2ee4d859a68038335da7b0d7688","type":"FileHash-SHA256","created":"2026-11-18T13:38:10","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590585535,"indicator":"2776cfcdd46264043b823adaf37e0c85d0efd3b46d5fdbb72219535061d44b86","type":"FileHash-SHA256","created":"2026-11-18T13:38:10","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4590585536,"indicator":"3d73d5342a11dce35081e70a4ea75d39ad65bc6d480337bd3