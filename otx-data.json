riced between $600-$1,000 monthly, the service commercializes sophisticated AiTM techniques, lowering technical barriers for attackers. The pairing of credential theft capabilities with anti-detection infrastructure creates a split-view environment where security tools see harmless content while intended victims are routed to live phishing pages targeting consumer, financial, and enterprise identity systems.","author_name":"AlienVault","modified":"2026-07-02T09:55:18.769000","created":"2026-07-02T09:50:33.226000","revision":3,"tlp":"white","public":1,"adversary":"kirapayload","indicators":[{"id":4443400267,"indicator":"allegro-pl.site","type":"domain","created":"2026-07-02T09:50:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4443400268,"indicator":"allegro-pl.top","type":"domain","created":"2026-07-02T09:50:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4443400269,"indicator":"charliesdemons.com","type":"domain","created":"2026-07-02T09:50:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4443400270,"indicator":"cloaked-demo.com","type":"domain","created":"2026-07-02T09:50:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4443400271,"indicator":"cloaked.gg","type":"domain","created":"2026-07-02T09:50:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4443400272,"indicator":"api.cloaked.gg","type":"hostname","created":"2026-07-02T09:50:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4443400273,"indicator":"capture.cloaked.gg","type":"hostname","created":"2026-07-02T09:50:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4443400274,"indicator":"cdn.cloaked.gg","type":"hostname","created":"2026-07-02T09:50:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["credential-theft","url-evasion","aitm","mfa-bypass","blacksite","session-hijacking","cloaking","reverse-proxy","tycoon 2fa","phishing-as-a-service"],"targeted_countries":[],"malware_families":["Blacksite","Tycoon 2FA"],"attack_ids":[],"references":["https:\/\/abnormal.ai\/es\/blog\/blacksite-aitm-phishing-kit-cloaked-gg"],"industries":["Finance","Technology"],"extract_source":[],"more_indicators":false},{"id":"6a4500fd1580f75d3cf32d5e","name":"Inside an affiliate panel targeting Microsoft 365","description":"Cisco Talos discovered ARToken, a sophisticated phishing-as-a-service panel sharing infrastructure and operational patterns with the EvilTokens platform. The panel exposes over 80 API endpoints enabling device code phishing, Primary Refresh Token persistence, email access, business email compromise operations, and SharePoint exfiltration through a React-based dashboard. The platform deploys a seven-layer anti-analysis system combining client-side behavioral verification with XOR-encrypted payloads. ARToken abuses Microsoft's OAuth 2.0 Device Authorization Grant to bypass multi-factor authentication entirely. Analysis reveals post-compromise capabilities including token management across password resets, automated BEC operations, inbox rule manipulation for evidence suppression, cross-account keyword monitoring, and SharePoint file operations. The platform operates as multi-tenant infrastructure with subscription-based affiliate access, representing a complete operations environment rather than simple phish...","author_name":"AlienVault","modified":"2026-07-02T07:03:17.390000","created":"2026-07-01T11:58:53.526000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4134980156,"indicator":"CVE-2025-20333","type":"CVE","created":"2026-07-01T11:58:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4134980157,"indicator":"CVE-2025-20362","type":"CVE","created":"2026-07-01T11:58:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4360288999,"indicator":"CVE-2026-20182","type":"CVE","created":"2026-07-01T11:58:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4441679667,"indicator":"dashboard-bl.pamconj.com","type":"hostname","created":"2026-07-01T11:58:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4441679668,"indicator":"spx.pamconj.com","type":"hostname","created":"2026-07-01T11:58:54","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["oauth abuse","phishing-as-a-service","eviltokens","business email compromise","microsoft 365","artoken","device code phishing","primary refresh token"],"targeted_countries":[],"malware_families":["ARToken","EvilTokens"],"attack_ids":["T1213.002","T1539","T1497.001","T1566.002","T1119","T1090","T1102","T1583.006","T1528","T1098.001","T1566","T1531","T1027","T1114.002","T1567.002","T1562.008","T1213","T1071.001","T1550.001","T1078.004"],"references":["https:\/\/blog.talosintelligence.com\/artoken-inside-an-eviltokens-affiliate-panel-targeting-microsoft-365\/"],"industries":["Finance","Healthcare"],"extract_source":[],"more_indicators":false},{"id":"6a4500ffd044499efcd70db1","name":"Browser-Only Ransomware: From LLM Hallucinations to a Practical Attack Technique","description":"Check Point Research discovered a novel browser-native ransomware technique that emerged from AI-generated code attributed to DeepSeek. The attack leverages the File System Access API in Chromium browsers to encrypt files without requiring native payloads, exploits, or app installations. A malicious sample disguised as an AI image upscaler was analyzed, revealing how LLMs can connect theoretical platform risks to practical attack workflows. The technique is particularly concerning on Android, where Chrome allows web pages to access photo directories after user approval through legitimate permission prompts. By using social engineering with a fake AI enhancement tool, attackers can persuade victims to grant folder-level access, enabling file exfiltration and encryption entirely within the browser. This demonstrates how frontier AI models can autonomously design novel attack chains by reasoning across existing knowledge.","author_name":"AlienVault","modified":"2026-07-02T07:02:30.309000","created":"2026-07-01T11:58:55.598000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4441673478,"indicator":"07c39f79ab92fb21557b82283472dce1c112f577d796111fb752c3c6d84c86b5","type":"FileHash-SHA256","created":"2026-07-01T11:58:56","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["infernograbber","llm-generated malware","android chrome exploitation","social engineering","deepseek","voidlink","ai-assisted attacks","phishing lures","file system access api","browser-native ransomware"],"targeted_countries":[],"malware_families":["InfernoGrabber","VoidLink"],"attack_ids":[],"references":["https:\/\/research.checkpoint.com\/2026\/browser-only-ransomware-from-llm-hallucinations-to-a-practical-attack-technique\/","https:\/\/research.checkpoint.com\/wp-content\/uploads\/2026\/06\/Screen_Recording_20260618_150743_Chrome.mp4"],"industries":[],"extract_source":[],"more_indicators":false}],"count":8738,"prefetch_pulse_ids":false,"t":0,"t2":0.04969048500061035,"t3":0.047460079193115234,"previous":null,"next":"https:\/\/otx.alienvault.com\/api\/v1\/pulses\/subscribed?limit=10&page=2"}