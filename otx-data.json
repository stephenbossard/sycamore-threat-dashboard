reated":"2026-03-11T15:49:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4148112766,"indicator":"x1337.cc","type":"domain","created":"2026-03-11T15:49:34","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["ddos","xmrig","botnet","vulnerability exploitation","rondodox","iot"],"targeted_countries":[],"malware_families":["RondoDox","XMRig"],"attack_ids":["T1047","T1592","T1190","T1572","T1595","T1569.001","T1102","T1588.002","T1059.004","T1078","T1571","T1573","T1496","T1498","T1105","T1021.001"],"references":["https:\/\/www.bitsight.com\/blog\/rondodox-botnet-infrastructure-analysis"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69b14da6cb1bf921c7ac6d22","name":"CastleRAT attack first to abuse Deno JavaScript runtime to evade enterprise security","description":"A sophisticated infection chain has been discovered that installs CastleRAT malware without leaving traces on disk. The attack uniquely abuses the Deno runtime as a malicious framework, combining social engineering, steganography, and in-memory execution to evade detection. The process involves tricking users into executing a command, installing Deno, running obfuscated JavaScript, and decoding a payload hidden in a JPEG image. CastleRAT then gains total control, performing host fingerprinting, keylogging, clipboard hijacking, digital identity theft, and audio\/video surveillance. This campaign demonstrates the evolution of malware towards invisibility and the need for advanced endpoint behavioral monitoring to detect such threats.","author_name":"AlienVault","modified":"2026-04-10T11:44:23.220000","created":"2026-03-11T11:10:30.530000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4247044890,"indicator":"ca37e31d651bbd5bbddef3ea716b8b4f","type":"FileHash-MD5","created":"2026-03-11T11:10:31","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4247044902,"indicator":"de9707a8505683930fccf5536e311242425d420a","type":"FileHash-SHA1","created":"2026-03-11T11:10:31","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4260944426,"indicator":"a4787a42070994b7f1222025828faf9b153710bb730e58da710728e148282e28","type":"FileHash-SHA256","created":"2026-03-11T11:10:31","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4243021512,"indicator":"bd8203ab88983bc081545ff325f39e9c5cd5eb6a99d04ae2a6cf862535c9829a","type":"FileHash-SHA256","created":"2026-03-11T11:10:31","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4214237618,"indicator":"serialmenot.com","type":"domain","created":"2026-03-11T11:10:31","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4260944427,"indicator":"dsennbuappec.zhivachkapro.com","type":"hostname","created":"2026-03-11T11:10:31","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["clickfix","social engineering","castlerat","deno","javascript","api abuse"],"targeted_countries":[],"malware_families":["CastleRAT"],"attack_ids":["T1557","T1033","T1056.001","T1059.007","T1123","T1115","T1082","T1071","T1140","T1555","T1055","T1125","T1016","T1083","T1204","T1027","T1573","T1012","T1059.006","T1027.002","T1105"],"references":["https:\/\/www.threatdown.com\/blog\/castlerat-cyber-attack-is-the-first-to-abuse-deno-javascript-runtime-to-evade-enterprise-security\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69b14da61bf814f470228146","name":"Stolen Service Accounts Lead to Rogue Workstations and Deep AD Compromise","description":"SentinelOne's DFIR team has responded to multiple incidents involving compromised FortiGate NGFW appliances used to establish footholds in targeted environments. Attackers exploited vulnerabilities or weak credentials to access FortiGate devices, extract configuration files containing service account credentials, and use those to join rogue workstations to Active Directory. In one case, the attacker used the access to deploy remote management tools and steal the NTDS.dit file. The incidents highlight the need for strong access controls, patching, and improved logging on edge devices. Organizations are advised to implement SIEM solutions to detect anomalous activity and automate responses.","author_name":"AlienVault","modified":"2026-04-10T11:44:23.220000","created":"2026-03-11T11:10:30.090000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4162869271,"indicator":"CVE-2025-59718","type":"CVE","created":"2026-03-11T11:10:30","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4162869272,"indicator":"CVE-2025-59719","type":"CVE","created":"2026-03-11T11:10:30","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4188236859,"indicator":"CVE-2026-24858","type":"CVE","created":"2026-03-11T11:10:30","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4225563354,"indicator":"ndibstersoft.com","type":"domain","created":"2026-03-11T11:10:30","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4225769293,"indicator":"neremedysoft.com","type":"domain","created":"2026-03-11T11:10:30","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["fortigate","ngfw","credential theft","cve-2025-59719","cve-2025-59718","rmm tools","cve-2026-24858","lateral movement"],"targeted_countries":[],"malware_families":[],"attack_ids":["T1074.001","T1543.003","T1055","T1505.003","T1136.002","T1059.001","T1078","T1570","T1105","T1021.001","T1003.003","T1569.002"],"references":["https:\/\/www.sentinelone.com\/blog\/fortigate-edge-intrusions\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69b13da0db907023c1bfc480","name":"KadNap Malware Turning Asus Routers Into Botnets","description":"A sophisticated new malware called KadNap has been discovered targeting Asus routers and conscripting them into a botnet for proxying malicious traffic. The malware employs a custom version of the Kademlia Distributed Hash Table protocol to conceal its command-and-control infrastructure within a peer-to-peer system, evading traditional network monitoring. The botnet, which has grown to over 14,000 infected devices, is marketed by a proxy service called Doppelganger, tailored for criminal activity. More than 60% of KadNap's victims are based in the United States. The malware demonstrates versatility by targeting various edge networking devices and employing different C2 servers for different victim types.","author_name":"AlienVault","modified":"2026-04-10T10:23:49.591000","created":"2026-03-11T10:02:07.876000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4260932450,"indicator":"0b3dbb951de7a216dd5032d783ba7d0a5ecda2bf872643c3a4ddd1667fb38ffe","type":"FileHash-SHA256","created":"2026-03-11T10:04:56","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4260932451,"indicator":"ebf9de6b67e94b2bd2b0dcda1941e04fef1a1dad830404813e468ab8744b7ed8","type":"FileHash-SHA256","created":"2026-03-11T10:04:56","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["iot devices","botnet","kademlia dht","kadnap","proxy service"],"targeted_countries":["United States of America","Taiwan","Hong Kong","Russian Federation"],"malware_families":["KadNap","TheMoon"],"attack_ids":["T1047","T1133","T1082","T1595","T1016","T1083","T1584","T1497","T1102","T1590","T1571","T1095","T1499","T1132","T1046"],"references":["https:\/\/blog.lumen.com\/silence-of-the-hops-the-kadnap-botnet"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69d80c2c976a9ec209e19217","name":"Payroll pirate attacks targeting Canadian employees","description":"Microsoft Incident Response researchers identified Storm-2755, a financially motivated threat actor conducting payroll pirate attacks against Canadian users. The campaign uses malvertising and SEO poisoning on generic search terms like \"Office 365\" to lure victims to a fraudulent sign-in page. Through adversary-in-the-middle techniques, the actor captures authentication tokens and session cookies, bypassing MFA protections. Storm-2755 maintains persistence using Axios HTTP client to replay stolen tokens, then conducts discovery for payroll and HR contacts. The actor impersonates compromised users to socially engineer HR staff or directly manipulates payroll systems like Workday. Malicious inbox rules hide correspondence from victims. Attacks resulted in direct financial losses through redirected salary payments to attacker-controlled bank accounts.","author_name":"AlienVault","modified":"2026-04-10T10:08:49.871000","created":"2026-04-09T20:29:32.260000","revision":3,"tlp":"white","public":1,"adversary":"Storm-2755","indicators":[{"id":4302448096,"indicator":"CVE-2025-27152","type":"CVE","created":"2026-04-09T20:29:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302448097,"indicator":"http:\/\/bluegraintours.com","type":"URL","created":"2026-04-09T20:29:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302448099,"indicator":"bluegraintours.com","type":"domain","created":"2026-04-09T20:29:33","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["malvertising","credential phishing","cve-2025-27152","payroll fraud","session hijacking","aitm","seo poisoning","token theft","canadian targeting"],"targeted_countries":[],"malware_families":[],"attack_ids":["T1078.004","T1087","T1566","T1539","T1069.003","T1069","T1185","T1566.002","T1114","T1087.004","T1098","T1110","T1136.003","T1213","T1078","T1136","T1556","T1114.003"],"references":["https:\/\/www.microsoft.com\/en-us\/security\/blog\/2026\/04\/09\/investigating-storm-2755-payroll-pirate-attacks-targeting-canadian-employees\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69d8b1848ae30fd4dab9095d","name":"In-Memory Loader Drops ScreenConnect","description":"In February 2026, an attack chain was discovered that utilized a fraudulent Adobe Acrobat Reader download page to deceive victims into installing ConnectWise's ScreenConnect, a legitimate remote access tool exploited for malicious purposes. The attack employs sophisticated evasion techniques including heavy obfuscation, .NET reflection for in-memory payload execution, and dynamic code construction. A VBScript loader initiates the chain by downloading and executing obfuscated PowerShell commands that compile C# code entirely in memory. The loader manipulates the Process Environment Block to masquerade as legitimate Windows processes and abuses auto-elevated COM objects to bypass User Account Control without user prompts. This multi-layered approach successfully evades signature-based defenses and hinders forensic analysis while ultimately deploying ScreenConnect for unauthorized remote access.","author_name":"AlienVault","modified":"2026-04-10T10:08:49.100000","created":"2026-04-10T08:15:00.129000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4302730184,"indicator":"07720d8220abc066b6fdb2c187ae58f5","type":"FileHash-MD5","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730185,"indicator":"07f95ff34fb330875d80afadca3f0d5b","type":"FileHash-MD5","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730186,"indicator":"3d389886e95f00fade1eea67a6c370d1","type":"FileHash-MD5","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730187,"indicator":"3effadb977eddd4c48c7850c8dc03b13","type":"FileHash-MD5","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730188,"indicator":"a7e5dbec37c8f431d175dfd9352db59f","type":"FileHash-MD5","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730189,"indicator":"c02448e016b2568173de3eedadd80149","type":"FileHash-MD5","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730190,"indicator":"c36910c4c8d23ec93f6ae7d7a2496ce5","type":"FileHash-MD5","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730191,"indicator":"e4b594a18fc2a6ee164a76bdea980bc0","type":"FileHash-MD5","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730192,"indicator":"http:\/\/eshareflies.im\/ad\/","type":"URL","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730193,"indicator":"http:\/\/x0.at\/qOfN.msi","type":"URL","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730194,"indicator":"https:\/\/x0.at\/qOfN.msi","type":"URL","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4302730195,"indicator":"eshareflies.im","type":"domain","created":"2026-04-10T08:15:01","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["in-memory execution","powershell staging","com abuse","remote access tool","peb manipulation","screenconnect","vbscript loader","uac bypass"],"targeted_countries":[],"malware_families":["ScreenConnect"],"attack_ids":["T1036.004","T1027","T1566.002","T1059.005","T1106","T1204.002","T1548.002","T1497.001","T1218.007","T1562.001","T1055.002","T1027.002","T1059.001","T1134.002","T1105","T1140"],"references":["https:\/\/www.zscaler.com\/blogs\/security-research\/memory-loader-drops-screenconnect"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69d8b0c258b4fef5541358bb","name":"NPM Package Supply Chain Compromise Leads to RAT Deployment","description":"A supply chain attack targeting the Axios npm package has been identified after threat actors compromised the npm account of the company's lead developer. Malicious versions (axios@1.14.1 and axios@0.30.4) were published containing a hidden dependency that executed postinstall scripts during npm installation. This automated execution downloaded and deployed a remote access trojan on affected systems without requiring user interaction, making it particularly dangerous for developer environments and CI\/CD pipelines. The compromise resulted in full remote access capabilities, potential credential exposure including API keys and SSH keys, and possible insertion of malicious code into software builds. Detection platforms identified suspicious process execution chains involving npm spawning command interpreters and network utilities, followed by outbound connections to attacker-controlled infrastructure.","author_name":"AlienVault","modified":"2026-04-10T10:05:34.566000","created":"2026-04-10T08:11:46.259000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4289443139,"indicator":"04e3073b3cd5c5bfcde6f575ecf6e8c1","type":"FileHash-MD5","created":"2026-04-10T08:11:47","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4289443140,"indicator":"7658962ae060a222c0058cd4e979bfa1","type":"FileHash-MD5","created":"2026-04-10T08:11:47","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"i