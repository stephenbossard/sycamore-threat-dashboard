 to Storm-0940's ConnectWise supply chain compromise. The framework enables automated operations from reconnaissance through data exfiltration with minimal human intervention. Ten percent of ARTEX hosts also run other offensive tools including Cobalt Strike, Vshell, and additional AI attack frameworks. Operators frequently expose open directories containing exploit binaries, post-exploitation kits, and session histories. The tool's developer claimed it was intended for authorized testing and took the repository offline after public attribution, though archived copies remain circulating.","author_name":"AlienVault","modified":"2026-11-06T10:46:14.322000","created":"2026-11-06T08:02:59.514000","revision":3,"tlp":"white","public":1,"adversary":"Storm-0940","indicators":[{"id":2873200796,"indicator":"CVE-2021-3156","type":"CVE","created":"2026-11-06T08:03:00","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4408681253,"indicator":"45.87.53.6","type":"IPv4","created":"2026-11-06T08:03:00","content":"","title":"","description":"","expiration":"2026-12-06T08:00:00","is_active":1,"role":null},{"id":4515940373,"indicator":"38.244.50.120","type":"IPv4","created":"2026-11-06T08:03:00","content":"","title":"","description":"","expiration":"2026-12-06T08:00:00","is_active":1,"role":null},{"id":4515940376,"indicator":"124.155.252.63","type":"IPv4","created":"2026-11-06T08:03:00","content":"","title":"","description":"","expiration":"2026-12-06T08:00:00","is_active":1,"role":null},{"id":4515940378,"indicator":"23.248.249.90","type":"IPv4","created":"2026-11-06T08:03:00","content":"","title":"","description":"","expiration":"2026-12-06T08:00:00","is_active":1,"role":null},{"id":4515940379,"indicator":"23.158.220.98","type":"IPv4","created":"2026-11-06T08:03:00","content":"","title":"","description":"","expiration":"2026-12-06T08:00:00","is_active":1,"role":null},{"id":4515940380,"indicator":"103.248.148.84","type":"IPv4","created":"2026-11