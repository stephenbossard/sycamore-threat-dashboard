hotejka","balada injector","tech support scam","help tds"],"targeted_countries":["United States of America","Australia","Belgium","Canada","France","Japan","Sweden"],"malware_families":["UltraViewer"],"attack_ids":["T1132.001","T1036.005","T1566.002","T1598.003","T1608.001","T1219","T1583.001","T1185","T1036.004","T1102","T1583.006","T1204","T1566","T1110","T1078","T1056","T1189","T1134","T1071.001","T1584.004"],"references":["https:\/\/www.infoblox.com\/blog\/threat-intelligence\/2026\/10\/inside-help-tds-hotejka-cloudflare-pages-and-predictive-detection"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"6aedb6e121254ba434499c9a","name":"Lookalike Domains Expose the iPhone Theft Economy","description":"A thriving underground marketplace operating primarily through Telegram has emerged to unlock stolen iPhones, making phone theft profitable despite Apple's security features like Activation Lock. Thieves combine technical tools and social engineering through SMS phishing campaigns using lookalike domains to trick legitimate owners into surrendering their passcodes. These unlocking tools, sold on pay-as-you-go basis for $5-50, can jailbreak older phones and extract information for crafting credible phishing attacks. Analysis reveals over 10,000 domains associated with these operations, with DNS traffic increasing 350% in 2025. Sellers operate globally from countries including Bangladesh, India, Pakistan, Venezuela, Mexico, and Brazil. The ecosystem prioritizes wiping devices for quick resale rather than data theft, with unlocked high-end phones fetching hundreds of dollars on black markets.","author_name":"AlienVault","modified":"2026-11-06T19:02:41.730000","created":"2026-11-06T11:15:45.531000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4566479925,"indicator":"apple.com-app.lt","type":"hostname","created":"2026-11-06T11:15:46","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4