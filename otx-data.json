e access tools like XenoRAT. Once executed, the malware established persistence, exfiltrated system information, and enabled remote control of compromised systems. Organizations are advised to verify email senders, avoid opening files from unknown sources, apply security patches, and maintain updated antivirus software to mitigate these persistent threats.","author_name":"AlienVault","modified":"2026-07-24T14:38:21.713000","created":"2026-07-24T12:34:39.512000","revision":2,"tlp":"white","public":1,"adversary":"Kimsuky","indicators":[{"id":4462655930,"indicator":"03e4bef86f3e3e6ea23eb6f017af0c98","type":"FileHash-MD5","created":"2026-07-24T12:34:40","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4462655931,"indicator":"05c07339603994b36dcfefcce720d03d","type":"FileHash-MD5","created":"2026-07-24T12:34:40","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4462655932,"indicator":"07bb21d28ae4ab07d62f8deb4343aaeb","type":"FileHash-MD5","created":"2026-07-24T12:34:40","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4462655933,"indicator":"07ed2c9ed61b60078af0164f061696be","type":"FileHash-MD5","created":"2026-07-24T12:34:40","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4462655934,"indicator":"0b1de625a89da12bd1fdd292b341bad3","type":"FileHash-MD5","created":"2026-07-24T12:34:40","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4462655935,"indicator":"bohyeonsanvil.com","type":"domain","created":"2026-07-24T12:34:40","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4462655936,"indicator":"kumhosports.com","type":"domain","created":"2026-07-24T12:34:40","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["xenorat","autoit","task scheduler","spear phishing","apt","pebbled