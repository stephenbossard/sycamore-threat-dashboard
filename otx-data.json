ke landing pages mimicking app stores, and PWAs that redirect to gambling sites through affiliate tracking links. Typical affiliate payouts range from $50 to $350 per depositing player, indicating significant financial motivation behind these operations.","author_name":"AlienVault","modified":"2026-07-03T06:59:19.779000","created":"2026-07-02T20:59:13.427000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":3236106593,"indicator":"topstatus.site","type":"domain","created":"2026-07-02T20:59:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4408486195,"indicator":"rewardsmonzo.website","type":"domain","created":"2026-07-02T20:59:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4408486245,"indicator":"optimismphantasm.shop","type":"domain","created":"2026-07-02T20:59:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4408486534,"indicator":"revvo-online.website","type":"domain","created":"2026-07-02T20:59:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4408486591,"indicator":"ridereuphoric.shop","type":"domain","created":"2026-07-02T20:59:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4408486752,"indicator":"seekerlucid.shop","type":"domain","created":"2026-07-02T20:59:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4444710872,"indicator":"345rodeoslot.com","type":"domain","created":"2026-07-02T20:59:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4444710873,"indicator":"87roulettino12.com","type":"domain","created":"2026-07-02T20:59:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4444710874,"indicator":"blinbd.com","type":"domain","created":"2026-07-02T20:59:14","content":