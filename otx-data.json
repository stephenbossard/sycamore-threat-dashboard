ileHash-SHA1","created":"2026-04-07T11:10:50","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4289443242,"indicator":"db7f4c82c732e8b107492cae419740ab","type":"FileHash-MD5","created":"2026-04-07T11:10:50","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4289443244,"indicator":"b0e0f12f1be57dc67fa375e860cedd19553c464d","type":"FileHash-SHA1","created":"2026-04-07T11:10:50","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4289444679,"indicator":"6483c004e207137385f480909d6edecf1b699087378aa91745ecba7c3394f9d7","type":"FileHash-SHA256","created":"2026-04-07T11:10:50","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4290563057,"indicator":"90e8e227ba8bef0ea7e0212b5b1e0d4c","type":"FileHash-MD5","created":"2026-04-07T11:10:50","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4290563058,"indicator":"dbd62d788ce8dcaa96116a73f70ee24813d59428","type":"FileHash-SHA1","created":"2026-04-07T11:10:50","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4293518435,"indicator":"e56bafda15a624b60ac967111d227bf8","type":"FileHash-MD5","created":"2026-04-07T11:10:50","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["supply chain attack","post-install execution","axios"],"targeted_countries":[],"malware_families":["plain-crypto-js","ld.py","wt.exe","com.apple.act.mond"],"attack_ids":["T1132.001","T1036.005","T1082","T1059.002","T1140","T1083","T1057","T1059.001","T1547.001","T1059.004","T1055.012","T1195.002","T1027.003","T1518.001","T1543.001","T1071.001","T1105","T1124"],"references":["https:\/\/www.elastic.co\/security-labs\/axios-supply-chain-compromise-detections"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69d456693a5b7bc100e26cad","name":"Unit42: Understanding Current Threats to Kubernetes Environments","description":"Palo Alto Networks Unit 42 explains that Kubernetes has become a prime target for attackers as its adoption accelerates in enterprise environments. Their research shows a sharp rise in Kubernetes-related malicious activity, driven less by classic container escape techniques and more by identity abuse and exposed application surfaces. Threat actors commonly gain initial access through misconfigurations or newly disclosed vulnerabilities, then steal Kubernetes service account tokens mounted inside compromised containers. With these identities, attackers can escalate privileges, move laterally across clusters and cloud services, and reach highly sensitive backend systems, making Kubernetes an effective pivot point into broader cloud infrastructure.","author_name":"AlienVault","modified":"2026-05-07T09:05:15.345000","created":"2026-04-07T00:57:13.022000","revision":3,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4157551390,"indicator":"CVE-2025-55182","type":"CVE","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4158471672,"indicator":"http:\/\/45.76.155.14\/vim","type":"URL","created":"2026-04-07T09:52:00","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4178459136,"indicator":"2c1d348131c4e3e1cb00002f226bad7e","type":"FileHash-MD5","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4178459142,"indicator":"9cdbc16912dcf188a0f0765ac21777b23b4b2bea","type":"FileHash-SHA1","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4178459143,"indicator":"05eac3663d47a29da0d32f67e10d161f831138e10958dcd88b9dc97038948f69","type":"FileHash-SHA256","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4200504512,"indicator":"CVE-2026-1731","type":"CVE","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4297738367,"indicator":"7d2c9b4a3942f6029d2de7f73723b505b64caa8e1763e4eb1f134360465185d0","type":"FileHash-SHA256","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4297738368,"indicator":"bb470a803b6d7b12fb596d2e4a18ea9ca91f40fd34ded7f01a487eed9a1d814d","type":"FileHash-SHA256","created":"2026-04-07T00:57:14","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4297957152,"indicator":"http:\/\/104.238.149.198:12349\/BVN0VEdddye5odDFVR","type":"URL","created":"2026-04-07T09:52:00","content":"","title":"","description":"","expiration":null,"is_active":1,"role":""}],"tags":["React2Shell","Kubernetes"],"targeted_countries":[],"malware_families":[],"attack_ids":["T1106","T1036","T1098","T1059","T1611","T1134","T1055","T1078","T1613"],"references":["https:\/\/unit42.paloaltonetworks.com\/modern-kubernetes-threats\/"],"industries":[],"extract_source":[],"more_indicators":false},{"id":"69fb57e600c03f5a6ac63de0","name":"Operation Silent Rotor: Rust-Based Malware Targets Eurasian Unmanned Aviation Sector Ahead of Moscow Summit","description":"A sophisticated spear phishing campaign targets professionals in the Eurasian unmanned aviation sector, timed to coincide with the XIII Eurasian International Forum 'Unmanned Aviation 2026' in Moscow. The attack delivers malicious archives containing Rust-based executables disguised as legitimate documents from the Russian Aeronautical Information Center. The malware displays aviation-themed decoy documents in Russian while collecting system information including hostnames, volume serial numbers, network adapter details, and environment variables. Collected data is encrypted via XOR and exfiltrated to a C2 server over HTTPS. The malware subsequently downloads and executes a second-stage payload using AES-256 decryption. The campaign demonstrates targeted social engineering with realistic aviation order documents, translation certificates, and product summaries to compromise victims in Russia, Tajikistan, Central Asia, Middle East and Europe.","author_name":"AlienVault","modified":"2026-05-07T08:38:48.908000","created":"2026-05-06T15:01:58.919000","revision":2,"tlp":"white","public":1,"adversary":"","indicators":[{"id":4346299530,"indicator":"2064ef387ac9e51ba72b32004d99e8a0b291dbab24ed8db30f437abf1b40cb49","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299531,"indicator":"57e26f6e3b311a1064c946b69159ee05abedf9228b2f95c65536429e7ac7fb24","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299532,"indicator":"89f8e42c825d09a0a50e99bbf7304d7037be33ea362a57d34f87fa7981f80126","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299533,"indicator":"a7bd8869293212e1671df90d2d41b96d4933eb9408b1111bd830e111a91bb202","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299534,"indicator":"fdef9e489f773319f55f92f712d1b7b5447d59a632b8f4173d1b161d3759ad92","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299535,"indicator":"45.142.36.76","type":"IPv4","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":"2026-06-05T15:00:00","is_active":1,"role":null},{"id":4346299536,"indicator":"89.108.110.154","type":"IPv4","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":"2026-06-05T15:00:00","is_active":1,"role":null},{"id":4346299537,"indicator":"92.62.113.232","type":"IPv4","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":"2026-06-05T15:00:00","is_active":1,"role":null},{"id":4346299538,"indicator":"http:\/\/kleymarket.ru","type":"URL","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299539,"indicator":"kleymarket.ru","type":"domain","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4346299540,"indicator":"cdn.kleymarket.ru","type":"hostname","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null}],"tags":["c2 exfiltration","multi-stage payload","aviation sector","unmanned aerial systems","spear phishing","rust malware","operation silent rotor","moscow summit"],"targeted_countries":["Russian Federation","Tajikistan"],"malware_families":[],"attack_ids":["T1033","T1204.002","T1566.001","T1082","T1106","T1140","T1016","T1083","T1036.004","T1041","T1027","T1059.003","T1071.001","T1105","T1090.001"],"references":["https:\/\/www.seqrite.com\/blog\/operation-silent-rotor-rust-malware-unmanned-aviation-sector\/"],"industries":["Aerospace"],"extract_source":[],"more_indicators":false},{"id":"69fb57e61f46ab512bd87fc1","name":"OceanLotus suspected of distributing ZiChatBot malware via wheel packages in PyPI","description":"Between July 2025 and present, threat actors suspected to be OceanLotus distributed malicious wheel packages through PyPI targeting both Windows and Linux platforms. Three fake libraries (uuid32-utils, colorinal, and termncolor) were created to imitate legitimate packages, implementing a sophisticated supply chain attack. The packages deployed droppers that delivered ZiChatBot, a previously unknown malware family using Zulip's REST APIs as command and control infrastructure instead of traditional C2 servers. The malware supports executing shellcode commands and establishes persistence through registry keys on Windows or crontab on Linux. Attribution to OceanLotus is based on 64% similarity with known droppers analyzed by KTAE system. The malicious packages were swiftly removed from PyPI following discovery.","author_name":"AlienVault","modified":"2026-05-07T08:37:37.816000","created":"2026-05-06T15:01:58.400000","revision":2,"tlp":"white","public":1,"adversary":"APT32","indicators":[{"id":4106774366,"indicator":"ba2f1868f2af9e191ebf47a5fab5cbab","type":"FileHash-MD5","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4106774370,"indicator":"1995682d600e329b7833003a01609252","type":"FileHash-MD5","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4106774372,"indicator":"5152410aeef667ffaf42d40746af4d84","type":"FileHash-MD5","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4120358137,"indicator":"38b75af6cbdb60127decd59140d10640","type":"FileHash-MD5","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4120358141,"indicator":"1c0a5b35c003ac3182c589c6e014a42678a0647f","type":"FileHash-SHA1","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4120358142,"indicator":"8a4a444761ca8836e6022af4a0e86a2be031aaa6","type":"FileHash-SHA1","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"is_active":1,"role":null},{"id":4120358145,"indicator":"08a75a092e9793b6d3eb473c246d3c5e4750cd525342276d8bf1ab7d1fe45112","type":"FileHash-SHA256","created":"2026-05-06T15:01:59","content":"","title":"","description":"","expiration":null,"i